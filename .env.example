# Smart_Fleet root env (copy to .env and fill in)
NODE_ENV=development

# ---- Postgres + PostGIS ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smartfleet
POSTGRES_USER=smartfleet
POSTGRES_PASSWORD=smartfleet_dev
DATABASE_URL=postgresql://smartfleet:smartfleet_dev@localhost:5432/smartfleet?schema=public

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- API ----
API_PORT=3000
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ---- SMS provider (abstract) ----
SMS_PROVIDER=mock   # mock | eocean | twilio
SMS_FROM=SmartFleet
SMS_API_KEY=

# ---- Routing provider (abstract) ----
ROUTING_PROVIDER=google   # google | osrm
GOOGLE_MAPS_API_KEY=
OSRM_BASE_URL=http://localhost:5000

# ---- Object storage ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=smartfleet

# ---- Push notifications ----
EXPO_ACCESS_TOKEN=

# ---- Payment gateways ----
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_RETURN_URL=

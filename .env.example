# Smart_Fleet root env (copy to .env and fill in)
# For Railway production/staging, set these via the Railway dashboard, not a .env file.
NODE_ENV=development

# ---- Postgres + PostGIS ----
# Local dev:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smartfleet
POSTGRES_USER=smartfleet
POSTGRES_PASSWORD=smartfleet_dev
DATABASE_URL=postgresql://smartfleet:smartfleet_dev@localhost:5432/smartfleet?schema=public
# Production (Neon): use the pooled connection string from the Neon dashboard.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/smartfleet?sslmode=require&pgbouncer=true

# ---- Redis ----
# Local dev:
REDIS_HOST=localhost
REDIS_PORT=6379
# Production (Upstash): use the rediss:// URL from the Upstash dashboard.
# REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

# ---- API ----
API_PORT=3000
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=43200
JWT_REFRESH_TTL=2592000

# ---- App-level encryption (AES-256-GCM for PII columns) ----
# REQUIRED in production. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# Set during key rotation; can read rows encrypted with this key, writes use the primary.
ENCRYPTION_KEY_OLD=
# HMAC key for deterministic blind index columns (e.g. phone search).
# Generate with: openssl rand -hex 32
BLIND_INDEX_KEY=

# ---- SMS provider ----
SMS_PROVIDER=mock        # mock | eocean
SMS_FROM=SmartFleet      # Eocean mask / sender ID
SMS_API_KEY=
# Eocean (Pakistan)
EOCEAN_USERNAME=
EOCEAN_PASSWORD=
EOCEAN_BASE_URL=https://sendpk.com/api/sms.php

# ---- Routing provider ----
ROUTING_PROVIDER=google  # google | osrm
GOOGLE_MAPS_API_KEY=
OSRM_BASE_URL=http://localhost:5000

# ---- Object storage (S3-compatible — works with R2, S3, GCS S3-interop, MinIO) ----
# Local dev (MinIO via docker compose):
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=smartfleet
# Production (Cloudflare R2):
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# S3_BUCKET=smart-fleet-prod

# ---- Push notifications ----
EXPO_ACCESS_TOKEN=

# ---- Payment gateways ----
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_RETURN_URL=

# ---- Feature flags (PostHog) ----
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# ---- Observability ----
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
BETTER_STACK_TOKEN=
BETTER_STACK_HOST=in.logs.betterstack.com
LOG_LEVEL=info

# ---- Build metadata (set by CI) ----
GIT_COMMIT_SHA=

# ---- Housekeeping ----
# HOUSEKEEPING_CRON=0 3 * * *
# HOUSEKEEPING_DISABLED=1

// Smart_Fleet Prisma schema
// PostgreSQL 16 + PostGIS 3.4. Spatial columns use Unsupported("geometry(...,4326)").
// Spatial queries go through PrismaService.$queryRaw.
//
// Changes ship only as migrations made with `npm run db:new-migration -- <name>`
// (docs/pilot/DATA_MODEL.md §2). Never `prisma db push` or `prisma db pull`.
// New columns stay nullable or defaulted (expand, then contract one release later),
// so the raw INSERTs on geometry tables keep working (DATA_MODEL §6).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuidOssp(map: "uuid-ossp"), pgcrypto]
}

// ---------- ENUMS ----------

enum UserRole {
  SUPER_ADMIN
  ADMIN
  DISPATCHER
  STORE_KEEPER
  DISTRIBUTOR
  DRIVER
  CLIENT
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum OtpPurpose {
  LOGIN
  RESET
}

enum CylinderState {
  FULL
  EMPTY
  FAULTY
  LOST
  PART_FILLED // Inc 2: a taken-back cylinder that is neither full nor empty (the driver's tap)
}

enum CustodyType {
  DISTRIBUTOR
  STORE
  VEHICLE
  CLIENT
}

enum CylinderEventType {
  SCAN_IN
  SCAN_OUT
  DELIVERED
  PICKED_UP_EMPTY
  RETURNED_TO_DISTRIBUTOR
  TRANSFER
  MARK_FAULTY
  MARK_LOST
  REGISTERED // Inc 2: bulk-registered into the home store (source REGISTRATION)
  FILLED // Inc 3: a refill's fill scan at the station (VEHICLE → VEHICLE; the state changes on the store's receive)
  ADJUSTED // Inc 3: an approved day-end fix (source DAY_END_FIX, the sheet's reason)
}

// Inc 2: how a cylinder move was recorded.
enum CylinderEventSource {
  SCAN // a QR scan
  TYPED // a cylinder number typed in (logged: audit custody.typed_entry)
  MANUAL // the office, with a reason (cylinder_events_reason_chk)
  REGISTRATION // bulk-register
  DAY_END_FIX // Inc 3: an approved day-end fix; the reason is required (cylinder_events_reason_chk)
}

// Inc 2: the two per-visit lists of a DELIVERY stop.
enum StopCylinderDirection {
  GIVEN
  TAKEN_BACK
}

// Inc 2: the customer confirmation link (record only, never money).
enum ConfirmationStatus {
  PENDING
  ANSWERED
  EXPIRED
  CANCELLED // reserved: nothing writes it in the pilot
}

enum ConfirmationResponse {
  YES // All received
  PARTLY // Partly received
  NO // Not received
  OTHER // Other problem
}

// Inc 2: the message log (outbound_messages).
enum MessageChannel {
  SMS
  WHATSAPP
  SHARE_LINK // the shop or the office passed the link on from an app
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SKIPPED // mock provider or test mode
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

enum DriverAvailability {
  AVAILABLE
  ON_LEAVE
  OFF_DUTY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  FAILED
}

// Legacy mirror for old app builds: PAID_VIA_LEDGER while Order.feeStatus is DEDUCTED, UNPAID otherwise.
enum OrderPaymentStatus {
  UNPAID
  PAID_VIA_LEDGER
  PAID_DIRECT
}

// The money state of an order. The cost is deducted when the order is placed and
// returned once, only on a cancel before delivery has started.
enum OrderFeeStatus {
  NONE // no cost taken: legacy order, or a cost of 0
  DEDUCTED
  REVERSED
}

enum FeeStrategy {
  DISTRIBUTOR_ZONE // pilot: the distributor's price for the customer's zone
  LEGACY_ZONE_PAIR // old orders priced by PricingRule
}

enum DeliveryMethod {
  DRIVER_TAP // Inc 1: the driver taps Delivered
  SCANNED // Inc 2: the hand-over scans
  MANUAL // the office, with a reason
}

enum TripStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ABORTED
}

enum TripStopType {
  STORE_PICKUP
  DELIVERY
  RETURN_DROPOFF
}

enum TripStopStatus {
  PENDING
  ARRIVED
  DONE
  FAILED
  CANCELLED
}

enum TransferStatus {
  REQUESTED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum PaymentProviderName {
  JAZZCASH
  EASYPAISA
  BANK_MANUAL
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  REJECTED // the super admin said no (legacy BANK_MANUAL FAILED rows are relabelled in inc1b)
}

enum PayerChannel {
  EASYPAISA_APP
  BANK_APP
  OTHER
}

// Signed ledger rows. Opening balances and corrections are ADJUSTMENT with a reason_code.
enum LedgerEntryType {
  CREDIT_TOPUP
  DEBIT_ORDER
  ADJUSTMENT
  CREDIT_ORDER_REVERSAL // the delivery cost returned on a cancel before delivery started
  DEBIT_REFILL // reserved for refill.deliveryCost; never written while it is off
}

enum DistributorStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ReconciliationStatus {
  PENDING
  VERIFIED
  FLAGGED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AuditActorKind {
  USER
  SYSTEM // jobs, CLIs and migrations; actor_label says which
  CUSTOMER // the confirmation link (Inc 2)
}

enum StoredFilePurpose {
  TOPUP_PROOF
  EXPENSE_RECEIPT
  DAY_END_SHEET
  DAY_END_UPLOAD
  OTHER
}

// ---------- USERS / AUTH ----------

model User {
  id           String     @id @default(uuid()) @db.Uuid
  phone        String     @unique
  email        String?    @unique
  name         String
  role         UserRole
  status       UserStatus @default(PENDING)
  cnic         String?
  profilePictureUrl String? @map("profile_picture_url")
  cnicEncrypted Bytes?    @map("cnic_encrypted")
  cnicIndex    String?    @map("cnic_index") @db.Char(64)
  passwordHash String?    @map("password_hash")
  /// Sent as the `tv` token claim; bumped on suspend, archive, role change and password reset.
  tokenVersion Int        @default(0) @map("token_version")
  /// Inc 3: made by `pilot:setup --test` (a test distributor's user or a test driver's user; never a
  /// SUPER_ADMIN). The pilot reset deletes only test rows and what hangs off them (API_CONTRACT §10.3).
  isTest       Boolean    @default(false) @map("is_test")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  distributorProfile Distributor?
  driverProfile      Driver?
  clientProfile      Client?
  refreshTokens      RefreshToken[]
  cylinderEvents     CylinderEvent[]  @relation("ActorEvents")
  auditLogs          AuditLog[]
  reconciliations    Reconciliation[]

  @@map("users")
}

model OtpCode {
  id         String     @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String     @map("code_hash")
  purpose    OtpPurpose
  expiresAt  DateTime   @map("expires_at")
  consumedAt DateTime?  @map("consumed_at")
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@map("otp_codes")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  parentId  String?   @map("parent_id") @db.Uuid
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------- ROLE PROFILES ----------

model Distributor {
  id                  String            @id @default(uuid()) @db.Uuid
  userId              String            @unique @map("user_id") @db.Uuid
  businessName        String            @map("business_name")
  /// Short code for human numbers (order AG-0142, top-up AG-T031): ^[A-Z][A-Z0-9]{1,5}$, set by the
  /// super admin, locked after the first order. Old rows were backfilled D01, D02... (inc1a).
  code                String            @unique
  /// The distributor's one store; every trip and refill starts there.
  homeStoreId         String            @unique @map("home_store_id") @db.Uuid
  /// THE wallet balance (no holds, no split). The ledger sum always equals it.
  advanceBalancePaisa BigInt            @default(0) @map("advance_balance_paisa")
  status              DistributorStatus @default(PENDING)
  /// Human-number counters, allocated inside the creating transaction (UPDATE ... RETURNING).
  nextOrderNo         Int               @default(1) @map("next_order_no")
  nextTopupNo         Int               @default(1) @map("next_topup_no")
  nextRefillNo        Int               @default(1) @map("next_refill_no") // Inc 3
  nextCylinderNo      Int               @default(1) @map("next_cylinder_no") // Inc 2
  /// The Idempotency-Key of POST /distributors: a retry returns this distributor (API_CONTRACT §4.2).
  clientRequestId     String?           @unique @map("client_request_id") @db.Uuid
  /// Inc 3: made by `pilot:setup --test`; the pilot reset deletes it and what hangs off it.
  isTest              Boolean           @default(false) @map("is_test")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  user          User                   @relation(fields: [userId], references: [id])
  homeStore     Store                  @relation(fields: [homeStoreId], references: [id], onDelete: Restrict)
  clients       Client[]
  cylinders     Cylinder[]
  orders        Order[]
  ledgerEntries LedgerEntry[]
  payments      Payment[]
  fillingOrders FillingOrder[]
  zonePrices    DistributorZonePrice[]
  files         StoredFile[]
  dayCloses     DayClose[]

  @@map("distributors")
}

model Driver {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @unique @map("user_id") @db.Uuid
  licenceNo                String    @unique @map("licence_no")
  currentVehicleId         String?   @unique @map("current_vehicle_id") @db.Uuid
  currentZoneId            String?   @map("current_zone_id") @db.Uuid
  currentLocation          Unsupported("geometry(Point,4326)")? @map("current_location")
  currentLocationUpdatedAt DateTime? @map("current_location_updated_at")
  isOnline                 Boolean   @default(false) @map("is_online")
  availability             DriverAvailability @default(AVAILABLE)
  leaveStart               DateTime? @map("leave_start")
  leaveEnd                 DateTime? @map("leave_end")
  leaveReason              String?   @map("leave_reason")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  user           User    @relation(fields: [userId], references: [id])
  currentVehicle Vehicle? @relation("DriverCurrentVehicle", fields: [currentVehicleId], references: [id])
  currentZone    Zone?    @relation(fields: [currentZoneId], references: [id])
  trips          Trip[]
  reconciliations Reconciliation[]
  shifts         DriverShift[]
  fuelRefills    FuelRefill[]
  fillingOrders  FillingOrder[]
  transfers      Transfer[]     @relation("TransferDriver")
  expenses       Expense[]

  @@index([isOnline])
  @@index([availability])
  @@map("drivers")
}

model DriverShift {
  id        String    @id @default(uuid()) @db.Uuid
  driverId  String    @map("driver_id") @db.Uuid
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  driver Driver @relation(fields: [driverId], references: [id])

  @@index([driverId, startedAt])
  @@map("driver_shifts")
}

// ---------- GEOGRAPHY ----------

model City {
  id          String @id @default(uuid()) @db.Uuid
  name        String
  countryCode String @default("PK") @map("country_code")

  zones        Zone[]
  pricingRules PricingRule[]

  @@map("cities")
}

model Zone {
  id        String @id @default(uuid()) @db.Uuid
  cityId    String @map("city_id") @db.Uuid
  name      String
  polygon   Unsupported("geometry(MultiPolygon,4326)")
  centroid  Unsupported("geometry(Point,4326)")?
  isActive  Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  city     City      @relation(fields: [cityId], references: [id])
  stores   Store[]
  vehicles Vehicle[]
  drivers  Driver[]
  ordersAsDest      Order[]       @relation("OrderDestZone")
  pricingAsOrigin   PricingRule[] @relation("PricingOrigin")
  pricingAsDest     PricingRule[] @relation("PricingDest")
  zonePrices        DistributorZonePrice[]
  clientAddresses   ClientAddress[]

  @@index([polygon], type: Gist)
  @@index([cityId, isActive])
  @@map("zones")
}

model Store {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  zoneId    String  @map("zone_id") @db.Uuid
  address   String
  location  Unsupported("geometry(Point,4326)")
  isActive  Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  zone           Zone           @relation(fields: [zoneId], references: [id])
  /// The one distributor whose store this is (Distributor.homeStoreId is unique).
  distributor    Distributor?
  ordersAsOrigin Order[]        @relation("OrderOriginStore")
  trips          Trip[]
  tripStops      TripStop[]
  transfersFrom  Transfer[]     @relation("TransferFromStore")
  transfersTo    Transfer[]     @relation("TransferToStore")
  fillingPickups FillingOrder[]

  @@index([location], type: Gist)
  @@map("stores")
}

// ---------- VEHICLES ----------

model Vehicle {
  id                String        @id @default(uuid()) @db.Uuid
  plateNo           String        @unique @map("plate_no")
  capacityUnits     Int           @map("capacity_units")
  homeZoneId        String        @map("home_zone_id") @db.Uuid
  status            VehicleStatus @default(ACTIVE)
  currentOdometerKm Int           @default(0) @map("current_odometer_km")
  /// Inc 3: a test driver's van made by `pilot:setup --test`; the pilot reset deletes it.
  isTest            Boolean       @default(false) @map("is_test")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  homeZone        Zone           @relation(fields: [homeZoneId], references: [id])
  currentDriver   Driver?        @relation("DriverCurrentVehicle")
  trips           Trip[]
  transfers       Transfer[]
  fuelRefills     FuelRefill[]
  fillingOrders   FillingOrder[]
  expenses        Expense[]

  @@map("vehicles")
}

// ---------- CLIENTS ----------

model Client {
  id               String   @id @default(uuid()) @db.Uuid
  distributorId    String   @map("distributor_id") @db.Uuid
  userId           String?  @unique @map("user_id") @db.Uuid
  name             String
  phone            String
  address          String?
  area             String?
  city             String?
  creditLimitPaisa BigInt   @default(0) @map("credit_limit_paisa")
  priority         Int      @default(3)
  notes            String?
  /// The Idempotency-Key of POST /clients: a retry returns this customer (API_CONTRACT §4.2).
  clientRequestId  String?  @map("client_request_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  distributor Distributor      @relation(fields: [distributorId], references: [id])
  user        User?            @relation(fields: [userId], references: [id])
  addresses   ClientAddress[]
  orders      Order[]

  @@unique([distributorId, clientRequestId])
  /// One customer per phone number within a distributor (inc1b; POST /clients checks it first).
  @@unique([distributorId, phone])
  @@index([distributorId])
  @@map("clients")
}

model ClientAddress {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  label     String
  location  Unsupported("geometry(Point,4326)")
  /// The zone that covered the pin when it was saved (NULL = outside every active zone), kept for the
  /// record; lists, quotes and orders re-check the pin live against the active zones.
  zoneId    String?  @map("zone_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id])
  zone   Zone?  @relation(fields: [zoneId], references: [id])

  @@index([clientId])
  @@map("client_addresses")
}

// ---------- CYLINDERS ----------

model CylinderType {
  id            String @id @default(uuid()) @db.Uuid
  code          String @unique
  name          String
  weightKg      Decimal @map("weight_kg") @db.Decimal(6, 2)
  capacityUnits Int     @map("capacity_units")

  cylinders  Cylinder[]
  orderLines OrderLine[]
  pricingRules PricingRule[]
  fillingOrders FillingOrder[]
  zonePriceSizes DistributorZonePriceSize[]
  stopCylinders     StopCylinder[]
  unlabelledReturns StopUnlabelledReturn[]
  dayCloseLines     DayCloseLine[]

  @@map("cylinder_types")
}

// Every cylinder has exactly one holder (custodyType + custodyId: a store, a van or a customer), and
// only a scan, the office's logged manual delivery or an approved day-end fix changes it (ADR-13).
model Cylinder {
  id             String        @id @default(uuid()) @db.Uuid
  serial         String        @unique
  qrCode         String        @unique @map("qr_code")
  distributorId  String        @map("distributor_id") @db.Uuid
  cylinderTypeId String        @map("cylinder_type_id") @db.Uuid
  /// Inc 2: the number on the label, per distributor (from Distributor.nextCylinderNo). Shown AG-C0042
  /// (formatNo(code, 'CYLINDER', shortNo)); typed 42, 0042, C0042 or AG-C0042 (parseCylinderNo).
  shortNo        Int?          @map("short_no")
  state          CylinderState @default(EMPTY)
  custodyType    CustodyType   @map("custody_type")
  custodyId      String        @map("custody_id") @db.Uuid
  /// Inc 2: the last move; its tripId says "loaded on this run". NULL when the newest old event didn't
  /// end at the current holder (inc2 backfill): such a cylinder is scanned into the store before it goes out.
  lastEventId    String?       @unique @map("last_event_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  distributor   Distributor     @relation(fields: [distributorId], references: [id])
  cylinderType  CylinderType    @relation(fields: [cylinderTypeId], references: [id])
  lastEvent     CylinderEvent?  @relation("CylinderLastEvent", fields: [lastEventId], references: [id], onDelete: SetNull)
  events        CylinderEvent[] @relation("CylinderEvents")
  transferLines TransferLine[]
  stopCylinders StopCylinder[]
  refillLines   FillingOrderCylinder[]
  dayCloseLines DayCloseLine[]

  @@unique([distributorId, shortNo])
  @@index([distributorId, cylinderTypeId, state, custodyType])
  @@index([custodyType, custodyId])
  @@map("cylinders")
}

// One row per move. The responsible driver is read from here: the trip's or refill's driver of the newest
// move onto a van since the cylinder last entered a store (API_CONTRACT §9.2).
model CylinderEvent {
  id              String              @id @default(uuid()) @db.Uuid
  cylinderId      String              @map("cylinder_id") @db.Uuid
  eventType       CylinderEventType   @map("event_type")
  /// Inc 2: SCAN, TYPED, MANUAL (the office; a reason is required) or REGISTRATION.
  source          CylinderEventSource @default(SCAN)
  fromCustodyType CustodyType?        @map("from_custody_type")
  fromCustodyId   String?             @map("from_custody_id") @db.Uuid
  toCustodyType   CustodyType?        @map("to_custody_type")
  toCustodyId     String?             @map("to_custody_id") @db.Uuid
  /// Inc 2: the cylinder's state before and after the move.
  fromState       CylinderState?      @map("from_state")
  toState         CylinderState?      @map("to_state")
  /// Inc 2: why (required unless the source is SCAN, TYPED or REGISTRATION: cylinder_events_reason_chk).
  reason          String?
  actorUserId     String              @map("actor_user_id") @db.Uuid
  /// Inc 2: the app's scan id. A resend with the same (actor, scan id) returns the recorded scan.
  clientScanId    String?             @map("client_scan_id") @db.Uuid
  photoUrl        String?             @map("photo_url")
  location        Unsupported("geometry(Point,4326)")?
  tripId          String?             @map("trip_id") @db.Uuid
  /// Inc 2: the stop of the move (a LOAD at the STORE_PICKUP stop, a HANDOVER or TAKE_BACK at a DELIVERY stop).
  tripStopId      String?             @map("trip_stop_id") @db.Uuid
  orderId         String?             @map("order_id") @db.Uuid
  transferId      String?             @map("transfer_id") @db.Uuid
  /// Inc 3: the refill of a refill move (PICKUP: SCAN_OUT with no trip; FILL: FILLED; the store's receive
  /// of a refill cylinder: SCAN_IN). A refill pickup never touches an order (DATA_MODEL §3.6).
  fillingOrderId  String?             @map("filling_order_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at")

  cylinder      Cylinder      @relation("CylinderEvents", fields: [cylinderId], references: [id])
  actor         User          @relation("ActorEvents", fields: [actorUserId], references: [id])
  tripStop      TripStop?     @relation(fields: [tripStopId], references: [id], onDelete: Restrict)
  fillingOrder  FillingOrder? @relation(fields: [fillingOrderId], references: [id], onDelete: Restrict)
  lastEventOf   Cylinder?     @relation("CylinderLastEvent")
  stopCylinder  StopCylinder?
  dayCloseLine  DayCloseLine? @relation("DayCloseLineAppliedEvent")

  @@unique([actorUserId, clientScanId])
  @@index([cylinderId, createdAt])
  @@index([tripId])
  @@index([orderId])
  @@index([createdAt])
  @@index([fillingOrderId])
  @@map("cylinder_events")
}

// ---------- INVENTORY ----------

model InventoryLot {
  id             String        @id @default(uuid()) @db.Uuid
  holderType     CustodyType   @map("holder_type")
  holderId       String        @map("holder_id") @db.Uuid
  distributorId  String        @map("distributor_id") @db.Uuid
  cylinderTypeId String        @map("cylinder_type_id") @db.Uuid
  state          CylinderState
  count          Int           @default(0)
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@unique([holderType, holderId, distributorId, cylinderTypeId, state], name: "inventory_unique")
  @@map("inventory_lots")
}

// ---------- TRANSFERS ----------

model Transfer {
  id            String         @id @default(uuid()) @db.Uuid
  fromStoreId   String         @map("from_store_id") @db.Uuid
  toStoreId     String         @map("to_store_id") @db.Uuid
  vehicleId     String?        @map("vehicle_id") @db.Uuid
  driverId      String?        @map("driver_id") @db.Uuid
  scheduledFor  DateTime?      @map("scheduled_for")
  notes         String?
  status        TransferStatus @default(REQUESTED)
  requestedBy   String         @map("requested_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")
  completedAt   DateTime?      @map("completed_at")

  fromStore Store           @relation("TransferFromStore", fields: [fromStoreId], references: [id])
  toStore   Store           @relation("TransferToStore", fields: [toStoreId], references: [id])
  vehicle   Vehicle?        @relation(fields: [vehicleId], references: [id])
  driver    Driver?         @relation("TransferDriver", fields: [driverId], references: [id])
  lines     TransferLine[]

  @@index([driverId, status])
  @@index([scheduledFor])
  @@map("transfers")
}

model TransferLine {
  id         String @id @default(uuid()) @db.Uuid
  transferId String @map("transfer_id") @db.Uuid
  cylinderId String @map("cylinder_id") @db.Uuid

  transfer Transfer @relation(fields: [transferId], references: [id])
  cylinder Cylinder @relation(fields: [cylinderId], references: [id])

  @@unique([transferId, cylinderId])
  @@map("transfer_lines")
}

// ---------- PRICING ----------

// Legacy zone-pair pricing (FeeStrategy.LEGACY_ZONE_PAIR). Frozen: read for old orders only.
model PricingRule {
  id              String   @id @default(uuid()) @db.Uuid
  cityId          String   @map("city_id") @db.Uuid
  originZoneId    String   @map("origin_zone_id") @db.Uuid
  destZoneId      String   @map("dest_zone_id") @db.Uuid
  cylinderTypeId  String   @map("cylinder_type_id") @db.Uuid
  basePaisa       BigInt   @map("base_paisa")
  perUnitPaisa    BigInt   @map("per_unit_paisa")
  effectiveFrom   DateTime @map("effective_from")
  effectiveUntil  DateTime? @map("effective_until")

  city         City         @relation(fields: [cityId], references: [id])
  originZone   Zone         @relation("PricingOrigin", fields: [originZoneId], references: [id])
  destZone     Zone         @relation("PricingDest", fields: [destZoneId], references: [id])
  cylinderType CylinderType @relation(fields: [cylinderTypeId], references: [id])

  @@unique([cityId, originZoneId, destZoneId, cylinderTypeId, effectiveFrom], name: "pricing_unique_active")
  @@map("pricing_rules")
}

// The delivery price: one current row per distributor per zone, edited in place
// (every edit writes a before/after audit row). Cost = base + Σ(per-size amount × full cylinders).
// Orders keep their own copy of the cost, so there is no foreign key from orders to this table.
model DistributorZonePrice {
  id              String   @id @default(uuid()) @db.Uuid
  distributorId   String   @map("distributor_id") @db.Uuid
  zoneId          String   @map("zone_id") @db.Uuid
  /// Charged once per order.
  basePaisa       BigInt   @map("base_paisa")
  note            String?
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  distributor Distributor                @relation(fields: [distributorId], references: [id])
  zone        Zone                       @relation(fields: [zoneId], references: [id])
  sizes       DistributorZonePriceSize[]

  @@unique([distributorId, zoneId])
  @@index([zoneId])
  @@map("distributor_zone_prices")
}

// Optional per-size amounts. A size with no row costs 0 per cylinder.
model DistributorZonePriceSize {
  id               String @id @default(uuid()) @db.Uuid
  priceId          String @map("price_id") @db.Uuid
  cylinderTypeId   String @map("cylinder_type_id") @db.Uuid
  perCylinderPaisa BigInt @map("per_cylinder_paisa")

  price        DistributorZonePrice @relation(fields: [priceId], references: [id], onDelete: Cascade)
  cylinderType CylinderType         @relation(fields: [cylinderTypeId], references: [id])

  @@unique([priceId, cylinderTypeId])
  @@map("distributor_zone_price_sizes")
}

// ---------- ORDERS / TRIPS ----------

model Order {
  id                   String              @id @default(uuid()) @db.Uuid
  distributorId        String              @map("distributor_id") @db.Uuid
  clientId             String              @map("client_id") @db.Uuid
  deliveryAddress      Unsupported("geometry(Point,4326)") @map("delivery_address")
  deliveryAddressLabel String              @map("delivery_address_label")
  destZoneId           String              @map("dest_zone_id") @db.Uuid
  originStoreId        String?             @map("origin_store_id") @db.Uuid
  /// Human number per distributor, shown as AG-0142 (from Distributor.nextOrderNo).
  orderNo              Int                 @map("order_no")
  /// The Idempotency-Key of "Place order": a retry returns the first order.
  clientRequestId      String?             @map("client_request_id") @db.Uuid
  status               OrderStatus         @default(PENDING)
  /// Legacy mirror for old app builds; read feeStatus.
  paymentStatus        OrderPaymentStatus  @default(UNPAID) @map("payment_status")
  /// The cost deducted from the wallet when the order was placed (0 when nothing was taken).
  deliveryFeePaisa     BigInt              @default(0) @map("delivery_fee_paisa")
  feeStatus            OrderFeeStatus      @default(NONE) @map("fee_status")
  feeStrategy          FeeStrategy?        @map("fee_strategy")
  feeBasePaisa         BigInt?             @map("fee_base_paisa")
  feeQuotedAt          DateTime?           @map("fee_quoted_at")
  /// {zoneId, zoneName, priceId, priceUpdatedAt}: display only; the amount columns are authoritative.
  feeDetails           Json?               @map("fee_details")
  scheduledWindowStart DateTime?           @map("scheduled_window_start")
  scheduledWindowEnd   DateTime?           @map("scheduled_window_end")
  tripId               String?             @map("trip_id") @db.Uuid
  assignedAt           DateTime?           @map("assigned_at")
  /// The first load scan on the order's trip: the refund cut-off (orders.deliveryStartedAt).
  loadStartedAt        DateTime?           @map("load_started_at")
  onTheWayAt           DateTime?           @map("on_the_way_at")
  /// Written once.
  deliveredAt          DateTime?           @map("delivered_at")
  deliveredByUserId    String?             @map("delivered_by_user_id") @db.Uuid
  deliveryMethod       DeliveryMethod?     @map("delivery_method")
  manualDeliveryReason String?             @map("manual_delivery_reason")
  /// The free-text cancel note; the stable code is cancelReasonCode.
  cancellationReason    String?             @map("cancellation_reason")
  cancelledAt          DateTime?           @map("cancelled_at")
  cancelledByUserId    String?             @map("cancelled_by_user_id") @db.Uuid
  cancelReasonCode     String?             @map("cancel_reason_code") // OrderCancelReason
  failedAt             DateTime?           @map("failed_at")
  failureReasonCode    String?             @map("failure_reason_code") // DeliveryFailureReason
  failureNote          String?             @map("failure_note")
  clientConfirmedAt     DateTime?           @map("client_confirmed_at")
  emptiesHandedOverAt   DateTime?           @map("empties_handed_over_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  distributor Distributor   @relation(fields: [distributorId], references: [id])
  client      Client        @relation(fields: [clientId], references: [id])
  destZone    Zone          @relation("OrderDestZone", fields: [destZoneId], references: [id])
  originStore Store?        @relation("OrderOriginStore", fields: [originStoreId], references: [id])
  trip        Trip?         @relation(fields: [tripId], references: [id])
  lines       OrderLine[]
  stops       TripStop[]
  ledger      LedgerEntry[]
  stopCylinders     StopCylinder[]
  unlabelledReturns StopUnlabelledReturn[]
  confirmation      DeliveryConfirmation?

  @@unique([distributorId, orderNo])
  @@unique([distributorId, clientRequestId])
  @@index([distributorId, status])
  @@index([distributorId, createdAt])
  @@index([status, createdAt])
  @@index([status, deliveredAt])
  @@index([tripId])
  @@map("orders")
}

model OrderLine {
  id                  String  @id @default(uuid()) @db.Uuid
  orderId             String  @map("order_id") @db.Uuid
  cylinderTypeId      String  @map("cylinder_type_id") @db.Uuid
  fullCount           Int     @map("full_count")
  expectedReturnCount Int     @default(0) @map("expected_return_count")
  /// Copy of the size's amount at placement (0 when the size has no amount).
  feePerCylinderPaisa BigInt? @map("fee_per_cylinder_paisa")
  feePaisa            BigInt? @map("fee_paisa")

  order        Order        @relation(fields: [orderId], references: [id])
  cylinderType CylinderType @relation(fields: [cylinderTypeId], references: [id])

  @@index([orderId])
  @@map("order_lines")
}

model Trip {
  id            String     @id @default(uuid()) @db.Uuid
  driverId      String     @map("driver_id") @db.Uuid
  vehicleId     String     @map("vehicle_id") @db.Uuid
  originStoreId String     @map("origin_store_id") @db.Uuid
  status        TripStatus @default(PLANNED)
  plannedAt     DateTime   @default(now()) @map("planned_at")
  startedAt     DateTime?  @map("started_at")
  completedAt   DateTime?  @map("completed_at")
  /// Inc 2: 5–300 characters, set only by a finish with cylinders left on the van while
  /// trip.allowFinishWithLeftovers is on (API_CONTRACT §9.3).
  leftoverReason String?   @map("leftover_reason")

  driver      Driver     @relation(fields: [driverId], references: [id])
  vehicle     Vehicle    @relation(fields: [vehicleId], references: [id])
  originStore Store      @relation(fields: [originStoreId], references: [id])
  orders      Order[]
  stops       TripStop[]

  @@index([driverId, status])
  @@map("trips")
}

model TripStop {
  id          String         @id @default(uuid()) @db.Uuid
  tripId      String         @map("trip_id") @db.Uuid
  orderId     String?        @map("order_id") @db.Uuid
  /// The store of a STORE_PICKUP or RETURN_DROPOFF stop.
  storeId     String?        @map("store_id") @db.Uuid
  seq         Int
  stopType    TripStopType   @map("stop_type")
  status      TripStopStatus @default(PENDING)
  location    Unsupported("geometry(Point,4326)")
  etaAt       DateTime?      @map("eta_at")
  arrivedAt   DateTime?      @map("arrived_at")
  departedAt  DateTime?      @map("departed_at")
  completedAt DateTime?      @map("completed_at")
  cancelledAt DateTime?      @map("cancelled_at")
  notes       String?

  trip  Trip   @relation(fields: [tripId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])
  store Store? @relation(fields: [storeId], references: [id])
  events            CylinderEvent[]
  stopCylinders     StopCylinder[]
  unlabelledReturns StopUnlabelledReturn[]

  @@unique([tripId, seq])
  @@index([orderId])
  @@map("trip_stops")
}

// Inc 2: the two per-visit lists of a DELIVERY stop: what was given and what was taken back. A cylinder
// given on a visit can't be taken back on it (the unique key), and a scan is never counted twice.
model StopCylinder {
  id             String                @id @default(uuid()) @db.Uuid
  tripStopId     String                @map("trip_stop_id") @db.Uuid
  orderId        String                @map("order_id") @db.Uuid
  cylinderId     String                @map("cylinder_id") @db.Uuid
  cylinderTypeId String                @map("cylinder_type_id") @db.Uuid
  direction      StopCylinderDirection
  /// TAKEN_BACK only: EMPTY, PART_FILLED or FULL, as the driver tapped (stop_cylinders_return_state_chk).
  returnState    CylinderState?        @map("return_state")
  /// The move that put the cylinder on this list.
  eventId        String                @unique @map("event_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at")

  tripStop     TripStop      @relation(fields: [tripStopId], references: [id], onDelete: Restrict)
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  cylinder     Cylinder      @relation(fields: [cylinderId], references: [id], onDelete: Restrict)
  cylinderType CylinderType  @relation(fields: [cylinderTypeId], references: [id], onDelete: Restrict)
  event        CylinderEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([tripStopId, cylinderId])
  @@index([orderId, direction])
  @@index([cylinderId])
  @@map("stop_cylinders")
}

// Inc 2: unlabelled or other-brand returns, counted by size and state at the door. They count as taken
// back but never get a holder. The PUT replaces the stop's list and keeps no row for a count of 0.
model StopUnlabelledReturn {
  id               String        @id @default(uuid()) @db.Uuid
  tripStopId       String        @map("trip_stop_id") @db.Uuid
  orderId          String        @map("order_id") @db.Uuid
  cylinderTypeId   String        @map("cylinder_type_id") @db.Uuid
  /// EMPTY, PART_FILLED or FULL.
  state            CylinderState
  /// Above 0 (stop_unlabelled_returns_count_chk).
  count            Int
  recordedByUserId String        @map("recorded_by_user_id") @db.Uuid
  updatedAt        DateTime      @updatedAt @map("updated_at")

  tripStop     TripStop     @relation(fields: [tripStopId], references: [id], onDelete: Restrict)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  cylinderType CylinderType @relation(fields: [cylinderTypeId], references: [id], onDelete: Restrict)

  @@unique([tripStopId, cylinderTypeId, state])
  @@map("stop_unlabelled_returns")
}

// Inc 2: the customer confirmation, one per order. A record only: it never moves money
// (docs/pilot/CUSTOMER_PAGE.md). The link token is derived, never stored: only its sha256.
model DeliveryConfirmation {
  id             String                @id @default(uuid()) @db.Uuid
  orderId        String                @unique @map("order_id") @db.Uuid
  distributorId  String                @map("distributor_id") @db.Uuid
  /// sha256 hex of the current link token.
  tokenHash      String                @unique @map("token_hash") @db.Char(64)
  /// "Make a new link" bumps it, so the old link stops working.
  tokenVersion   Int                   @default(1) @map("token_version")
  /// The Idempotency-Key of the last new link, for its replay.
  lastNewLinkKey String?               @map("last_new_link_key") @db.Uuid
  status         ConfirmationStatus    @default(PENDING)
  /// delivered_at + confirmation.linkTtlHours; never extended.
  expiresAt      DateTime              @map("expires_at")
  /// NULL = the customer's number is not a valid mobile; refreshed from the customer on every new link.
  phoneE164      String?               @map("phone_e164")
  /// What the page shows, frozen at delivery (CUSTOMER_PAGE §3).
  snapshot       Json
  response       ConfirmationResponse?
  comment        String?               @db.VarChar(300)
  respondedAt    DateTime?             @map("responded_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  order    Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  messages OutboundMessage[]

  @@index([status, expiresAt])
  @@index([distributorId, createdAt])
  @@map("delivery_confirmations")
}

// Inc 2: every SMS attempt and every app share of a confirmation link (the message log). The link
// token never appears here: bodyRedacted has it replaced by [link].
model OutboundMessage {
  id                String         @id @default(uuid()) @db.Uuid
  channel           MessageChannel
  /// mock | eocean | share-whatsapp | share-sms | share-sheet | share-copy
  provider          String
  toPhoneE164       String?        @map("to_phone_e164")
  /// sms.deliveryConfirm.v1
  templateKey       String         @map("template_key")
  locale            String         @default("en")
  bodyRedacted      String         @map("body_redacted") @db.VarChar(320)
  status            MessageStatus  @default(QUEUED)
  providerMessageId String?        @map("provider_message_id")
  /// MOCK_PROVIDER, NOT_A_TEST_PHONE, INVALID_NUMBER, ...
  errorCode         String?        @map("error_code")
  /// confirm:<orderId>:v<n>:sms | share:<orderId>:<Idempotency-Key, or a new uuid>
  idempotencyKey    String         @unique @map("idempotency_key")
  confirmationId    String?        @map("confirmation_id") @db.Uuid
  /// The link version the message carried; reach and lastMessage read only the current one.
  tokenVersion      Int?           @map("token_version")
  orderId           String?        @map("order_id") @db.Uuid
  distributorId     String?        @map("distributor_id") @db.Uuid
  createdByUserId   String?        @map("created_by_user_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at")
  sentAt            DateTime?      @map("sent_at")

  confirmation DeliveryConfirmation? @relation(fields: [confirmationId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([orderId, createdAt])
  @@map("outbound_messages")
}

// ---------- PAYMENTS / LEDGER ----------

// A top-up request. Manual bank top-ups are approved once, against the company bank app.
model Payment {
  id               String              @id @default(uuid()) @db.Uuid
  distributorId    String              @map("distributor_id") @db.Uuid
  /// Human number per distributor, shown as AG-T031 (from Distributor.nextTopupNo).
  requestNo        Int                 @map("request_no")
  /// The Idempotency-Key of the request: a retry returns the first payment.
  clientRequestId  String?             @map("client_request_id") @db.Uuid
  amountPaisa      BigInt              @map("amount_paisa")
  provider         PaymentProviderName
  /// The gateway's transaction id (Easypaisa later). NULL for BANK_MANUAL: no '' placeholders.
  providerTxnId    String?             @map("provider_txn_id")
  status           PaymentStatus       @default(PENDING)
  payerName        String?             @map("payer_name")
  payerChannel     PayerChannel?       @map("payer_channel")
  /// As the distributor typed it; informational, not unique.
  transactionId    String?             @map("transaction_id")
  /// Legacy slip URL of old rows; new screenshots use proofFileId.
  proofUrl         String?             @map("proof_url")
  proofFileId      String?             @map("proof_file_id") @db.Uuid
  /// As the super admin typed it from the company bank app.
  bankReference    String?             @map("bank_reference")
  /// Upper-case A-Z0-9 only, set on approval. Unique: one bank payment approves one top-up, ever.
  bankReferenceKey String?             @unique @map("bank_reference_key")
  /// The amount credited.
  bankAmountPaisa  BigInt?             @map("bank_amount_paisa")
  bankReceivedAt   DateTime?           @map("bank_received_at")
  rejectReasonCode String?             @map("reject_reason_code") // TopupRejectReason
  rejectNote       String?             @map("reject_note")
  /// Who reviewed the request (approve or reject); completedAt is when.
  verifiedByUserId String?             @map("verified_by_user_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at")
  completedAt      DateTime?           @map("completed_at")

  distributor   Distributor   @relation(fields: [distributorId], references: [id])
  proofFile     StoredFile?   @relation(fields: [proofFileId], references: [id], onDelete: Restrict)
  ledgerEntries LedgerEntry[]

  @@unique([provider, providerTxnId])
  @@unique([distributorId, requestNo])
  @@unique([distributorId, clientRequestId])
  @@index([distributorId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

// Append-only. The sum of a distributor's rows equals Distributor.advanceBalancePaisa.
model LedgerEntry {
  id                String          @id @default(uuid()) @db.Uuid
  distributorId     String          @map("distributor_id") @db.Uuid
  entryType         LedgerEntryType @map("entry_type")
  /// Signed: + money in, - money out.
  amountPaisa       BigInt          @map("amount_paisa")
  /// The balance after this row.
  balanceAfterPaisa BigInt          @map("balance_after_paisa")
  /// Exactly-once key: topup:<paymentId>, order:<id>:debit, order:<id>:reversal, adjust:<Idempotency-Key>,
  /// opening:<distributorId>, legacy:<id>.
  idempotencyKey    String          @unique @map("idempotency_key")
  paymentId         String?         @map("payment_id") @db.Uuid
  orderId           String?         @map("order_id") @db.Uuid
  /// Links old refill debits (legacy ADJUSTMENT rows).
  fillingOrderId    String?         @map("filling_order_id") @db.Uuid
  /// CorrectionReason for ADJUSTMENT rows (OPENING_BALANCE for opening entries).
  reasonCode        String?         @map("reason_code")
  note              String?
  /// NULL = a system job.
  createdByUserId   String?         @map("created_by_user_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at")

  distributor  Distributor   @relation(fields: [distributorId], references: [id])
  payment      Payment?      @relation(fields: [paymentId], references: [id])
  order        Order?        @relation(fields: [orderId], references: [id])
  fillingOrder FillingOrder? @relation(fields: [fillingOrderId], references: [id], onDelete: Restrict)

  @@index([distributorId, createdAt])
  @@index([orderId])
  @@index([fillingOrderId])
  @@map("ledger_entries")
}

// ---------- RECONCILIATION ----------

model Reconciliation {
  id                  String               @id @default(uuid()) @db.Uuid
  driverId            String               @map("driver_id") @db.Uuid
  forDate             DateTime             @map("for_date") @db.Date
  expectedCashPaisa   BigInt               @map("expected_cash_paisa")
  submittedCashPaisa  BigInt               @map("submitted_cash_paisa")
  cylindersDelivered  Int                  @map("cylinders_delivered")
  cylindersReturned   Int                  @map("cylinders_returned")
  status              ReconciliationStatus @default(PENDING)
  verifiedByUserId    String?              @map("verified_by_user_id") @db.Uuid
  note                String?
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  driver       Driver @relation(fields: [driverId], references: [id])
  verifiedBy   User?  @relation(fields: [verifiedByUserId], references: [id])

  @@unique([driverId, forDate])
  @@map("reconciliations")
}

// ---------- SUPPORT / AUDIT ----------

model SupportTicket {
  id              String        @id @default(uuid()) @db.Uuid
  subjectType     String        @map("subject_type")
  subjectId       String?       @map("subject_id") @db.Uuid
  reporterUserId  String        @map("reporter_user_id") @db.Uuid
  assigneeUserId  String?       @map("assignee_user_id") @db.Uuid
  status          TicketStatus  @default(OPEN)
  priority        Int           @default(3)
  subject         String
  body            String
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([status, priority])
  @@map("support_tickets")
}

model AuditLog {
  id            String         @id @default(uuid()) @db.Uuid
  actorKind     AuditActorKind @default(USER) @map("actor_kind")
  /// Set exactly when actorKind is USER (CHECK audit_logs_actor_chk).
  actorUserId   String?        @map("actor_user_id") @db.Uuid
  /// For SYSTEM and CUSTOMER actors: job:wallet-check, migration:inc1a, cli:settings, link:AG-0142.
  actorLabel    String?        @map("actor_label")
  /// Stable action code (API_CONTRACT Appendix B), e.g. topup.approve, wallet.correction.
  action        String
  resourceType  String         @map("resource_type")
  resourceId    String?        @map("resource_id") @db.Uuid
  distributorId String?        @map("distributor_id") @db.Uuid
  reason        String?
  diff          Json?
  ip            String?
  userAgent     String?        @map("user_agent")
  requestId     String?        @map("request_id")
  createdAt     DateTime       @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([resourceType, resourceId])
  @@index([distributorId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------- ALERTS ----------

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum AlertType {
  DISPATCH_NO_CANDIDATE
  LOW_STOCK
  ORDER_STUCK_PENDING
  DRIVER_OFFLINE_WHILE_ON_TRIP
  PAYMENT_FAILED
  RECONCILIATION_MISMATCH
  CYLINDER_LOST
  DISTRIBUTOR_BALANCE_LOW
  DISTRIBUTOR_CREDIT_OVER
  STORE_STOCK_LOW
  SPECIAL_CLIENT
  OTHER
  WALLET_CHECK_MISMATCH // nightly check: ledger sum <> balance, or balance < 0
  CUSTOMER_PROBLEM // Inc 2: a case, opened by a confirmation answer; the answer is in context
  VAN_NOT_EMPTY // Inc 2: a van holding cylinders at the cut-off, or a run finished with leftovers
  DAY_END_SUBMITTED // Inc 3: a shop sent its day-end for approval (resource the day; approve and send-back resolve it)
}

// User-defined alert rules. Evaluated lazily when the admin opens the
// alerts page (no separate worker needed for the v1 set). `threshold`
// is interpreted per `ruleKind`:
//   DISTRIBUTOR_BALANCE_LOW  → paisa (raise when advance balance falls below)
//   DISTRIBUTOR_CREDIT_OVER  → paisa (raise when negative balance exceeds)
//   STORE_STOCK_LOW          → cylinder count (raise when full count below)
//   SPECIAL_CLIENT           → unused; resourceId points at the Client.
enum AlertRuleKind {
  DISTRIBUTOR_BALANCE_LOW
  DISTRIBUTOR_CREDIT_OVER
  STORE_STOCK_LOW
  SPECIAL_CLIENT
}

model AlertRule {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  ruleKind      AlertRuleKind @map("rule_kind")
  threshold     BigInt        @default(0)
  resourceId    String?       @map("resource_id") @db.Uuid
  cylinderTypeId String?      @map("cylinder_type_id") @db.Uuid
  severity      AlertSeverity @default(WARNING)
  isActive      Boolean       @default(true) @map("is_active")
  notes         String?
  createdBy     String        @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  lastTriggeredAt DateTime?   @map("last_triggered_at")

  @@index([isActive, ruleKind])
  @@map("alert_rules")
}

model Alert {
  id           String        @id @default(uuid()) @db.Uuid
  alertType    AlertType     @map("alert_type")
  severity     AlertSeverity @default(WARNING)
  status       AlertStatus   @default(OPEN)
  title        String
  body         String
  resourceType String?       @map("resource_type")
  resourceId   String?       @map("resource_id") @db.Uuid
  /// Inc 2: the distributor a case belongs to, so the shop sees its own (GET /alerts/mine).
  distributorId String?      @map("distributor_id") @db.Uuid
  context      Json?
  acknowledgedAt DateTime?   @map("acknowledged_at")
  resolvedAt   DateTime?     @map("resolved_at")
  /// Inc 2: who closed a case (POST /alerts/:id/resolve). No foreign key (DATA_MODEL §1 rule 5).
  resolvedByUserId String?   @map("resolved_by_user_id") @db.Uuid
  /// Inc 2: the office's note when it closed the case.
  resolutionNote   String?   @map("resolution_note") @db.VarChar(300)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([status, severity, createdAt])
  @@index([distributorId, status, createdAt])
  @@map("alerts")
}


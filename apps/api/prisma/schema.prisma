// ---------- ACCESSORIES (pipes, connectors, regulators, etc.) ----------

enum AccessoryCategory {
  PIPE
  CONNECTOR
  REGULATOR
  VALVE
  BURNER
  HOSE
  ADAPTER
  VAPORISER
  OTHER
}

enum AccessoryMovementReason {
  RECEIPT
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  DAMAGE_LOSS
}

model Accessory {
  id                String            @id @default(uuid()) @db.Uuid
  code              String            @unique
  name              String
  category          AccessoryCategory
  unit              String
  defaultPricePaisa BigInt            @default(0) @map("default_price_paisa")
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  stock     AccessoryStock[]
  movements AccessoryMovement[]

  @@map("accessories")
}

model AccessoryStock {
  id             String   @id @default(uuid()) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  accessoryId    String   @map("accessory_id") @db.Uuid
  quantity       Int      @default(0)
  unitPricePaisa BigInt?  @map("unit_price_paisa")
  updatedAt      DateTime @updatedAt @map("updated_at")

  accessory Accessory @relation(fields: [accessoryId], references: [id])

  @@unique([storeId, accessoryId])
  @@index([storeId])
  @@map("accessory_stock")
}

model AccessoryMovement {
  id          String                  @id @default(uuid()) @db.Uuid
  storeId     String                  @map("store_id") @db.Uuid
  accessoryId String                  @map("accessory_id") @db.Uuid
  delta       Int
  reason      AccessoryMovementReason
  note        String?
  actorUserId String                  @map("actor_user_id") @db.Uuid
  createdAt   DateTime                @default(now()) @map("created_at")

  accessory Accessory @relation(fields: [accessoryId], references: [id])

  @@index([storeId, createdAt])
  @@index([accessoryId, createdAt])
  @@map("accessory_movements")
}

// ---------- FILLING STATIONS + FILLING ORDERS ----------

model FillingStation {
  id                    String   @id @default(uuid()) @db.Uuid
  name                  String
  address               String
  location              Unsupported("geometry(Point,4326)")
  pricePerCylinderPaisa BigInt   @default(0) @map("price_per_cylinder_paisa")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  fillingOrders FillingOrder[]

  @@map("filling_stations")
}

enum FillingOrderStatus {
  PENDING
  ASSIGNED
  EMPTIES_PICKED
  AT_STATION
  FILLED
  RETURNED
  COMPLETED
  CANCELLED
  FAILED
}

enum FillingServiceType {
  OUR_SERVICE
  DIY
}

// Inc 3: one picked cylinder of a refill (filling_order_cylinders). RETURNED is the store's receive scan,
// whether or not it was filled; the refill completes when every picked line is RETURNED (ADR-16).
enum FillingOrderCylinderStatus {
  PICKED_UP
  FILLED
  RETURNED
}

model FillingOrder {
  id                    String             @id @default(uuid()) @db.Uuid
  distributorId         String             @map("distributor_id") @db.Uuid
  fillingStationId      String?            @map("filling_station_id") @db.Uuid
  cylinderTypeId        String             @map("cylinder_type_id") @db.Uuid
  serviceType           FillingServiceType @default(OUR_SERVICE) @map("service_type")
  ownStationName        String?            @map("own_station_name")
  ownStationAddress     String?            @map("own_station_address")
  ownStationNotes       String?            @map("own_station_notes")
  /// One size per refill; at most `refill.maxCylinders` (30), enforced in code (filling_orders_count_chk: > 0).
  requestedCount        Int                @map("requested_count")
  /// Legacy (Inc 1 count steps). From Inc 3 the counts come from the refill's lines.
  pickedUpEmptyCount    Int?               @map("picked_up_empty_count")
  /// Legacy (Inc 1 count steps).
  filledCount           Int?               @map("filled_count")
  /// Always written as 0: refills carry no money (ADR-16).
  pricePerCylinderPaisa BigInt             @map("price_per_cylinder_paisa")
  /// Always written as 0: refills carry no money (ADR-16).
  totalCostPaisa        BigInt             @default(0) @map("total_cost_paisa")
  status                FillingOrderStatus @default(PENDING)
  assignedDriverId      String?            @map("assigned_driver_id") @db.Uuid
  assignedVehicleId     String?            @map("assigned_vehicle_id") @db.Uuid
  pickupStoreId         String?            @map("pickup_store_id") @db.Uuid
  cancellationReason    String?            @map("cancellation_reason")
  /// Inc 3: the human number (AG-R007), from Distributor.nextRefillNo in the creating transaction.
  refillNo              Int?               @map("refill_no")
  /// Inc 3: the Idempotency-Key of POST /filling-orders: a retry returns this refill (API_CONTRACT §10.1).
  clientRequestId       String?            @map("client_request_id") @db.Uuid
  /// Inc 3: the first pickup scan (after it, the owner can no longer cancel).
  pickedUpAt            DateTime?          @map("picked_up_at")
  /// Inc 3: the owner's cancel (only before pickup); old CANCELLED rows were backfilled from updated_at.
  cancelledAt           DateTime?          @map("cancelled_at")
  cancelledByUserId     String?            @map("cancelled_by_user_id") @db.Uuid
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  completedAt           DateTime?          @map("completed_at")

  distributor     Distributor     @relation(fields: [distributorId], references: [id])
  fillingStation  FillingStation? @relation(fields: [fillingStationId], references: [id])
  cylinderType    CylinderType    @relation(fields: [cylinderTypeId], references: [id])
  assignedDriver  Driver?         @relation(fields: [assignedDriverId], references: [id])
  assignedVehicle Vehicle?        @relation(fields: [assignedVehicleId], references: [id])
  pickupStore     Store?          @relation(fields: [pickupStoreId], references: [id])
  ledgerEntries   LedgerEntry[]
  cylinders       FillingOrderCylinder[]
  cylinderEvents  CylinderEvent[]

  @@unique([distributorId, refillNo])
  @@unique([distributorId, clientRequestId])
  @@index([assignedDriverId, status])
  @@index([status, createdAt])
  @@index([distributorId, createdAt])
  @@map("filling_orders")
}

// Inc 3: the cylinders a refill picked up, one row each (API_CONTRACT §10.1). The cylinder stays with the
// van during the refill (no station holder); the store's receive scan makes the line RETURNED, and FULL
// when it has filled_at.
model FillingOrderCylinder {
  id             String                     @id @default(uuid()) @db.Uuid
  fillingOrderId String                     @map("filling_order_id") @db.Uuid
  cylinderId     String                     @map("cylinder_id") @db.Uuid
  status         FillingOrderCylinderStatus @default(PICKED_UP)
  /// EMPTY or PART_FILLED (foc_pickup_state_chk).
  stateAtPickup  CylinderState              @map("state_at_pickup")
  pickedUpAt     DateTime                   @default(now()) @map("picked_up_at")
  /// The fill scan at the station.
  filledAt       DateTime?                  @map("filled_at")
  /// The store's receive scan.
  returnedAt     DateTime?                  @map("returned_at")

  fillingOrder FillingOrder @relation(fields: [fillingOrderId], references: [id], onDelete: Restrict)
  cylinder     Cylinder     @relation(fields: [cylinderId], references: [id], onDelete: Restrict)

  @@unique([fillingOrderId, cylinderId])
  @@index([cylinderId])
  @@map("filling_order_cylinders")
}


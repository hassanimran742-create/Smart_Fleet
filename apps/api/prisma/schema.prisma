// ---------- EXPENSES (super-admin only) ----------

// Legacy fixed categories; old rows were mapped to expense types (archived LEGACY_* types for
// categories with no seeded type). Dropped after the pilot.
enum ExpenseCategory {
  FOOD
  UTILITIES
  LABOUR
  FUEL
  MAINTENANCE
  RENT
  OFFICE
  TRAVEL
  EQUIPMENT
  OTHER
}

// Expenses never touch wallets or the ledger. Removing one is a logged void, never a hard delete.
model Expense {
  id               String           @id @default(uuid()) @db.Uuid
  /// Legacy; read typeId. Dropped after the pilot.
  category         ExpenseCategory?
  typeId           String           @map("type_id") @db.Uuid
  /// The expense's note (UI label "Note").
  description      String
  amountPaisa      BigInt           @map("amount_paisa")
  expenseDate      DateTime         @map("expense_date") @db.Date
  vehicleId        String?          @map("vehicle_id") @db.Uuid
  driverId         String?          @map("driver_id") @db.Uuid
  receiptFileId    String?          @map("receipt_file_id") @db.Uuid
  /// The Idempotency-Key of the create.
  clientRequestId  String?          @unique @map("client_request_id") @db.Uuid
  /// Legacy: kept, never written (receipts are receiptFileId).
  receiptUrl       String?          @map("receipt_url")
  recordedByUserId String           @map("recorded_by_user_id") @db.Uuid
  /// Legacy: kept, never written.
  vendor           String?
  /// Legacy: kept, never written (the note is description).
  notes            String?
  voidedAt         DateTime?        @map("voided_at")
  voidedByUserId   String?          @map("voided_by_user_id") @db.Uuid
  voidReason       String?          @map("void_reason")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  type        ExpenseType  @relation(fields: [typeId], references: [id], onDelete: Restrict)
  vehicle     Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver      Driver?      @relation(fields: [driverId], references: [id], onDelete: Restrict)
  receiptFile StoredFile?  @relation(fields: [receiptFileId], references: [id], onDelete: Restrict)

  @@index([expenseDate])
  @@index([category, expenseDate])
  @@index([typeId, expenseDate])
  @@index([vehicleId, expenseDate])
  @@index([driverId, expenseDate])
  @@map("expenses")
}

// Managed by the super admin: add, rename, archive. Seeded types have a stable code.
model ExpenseType {
  id              String    @id @default(uuid()) @db.Uuid
  /// PETROL, MAINTENANCE, REPAIRS, TYRES, TOLL_PARKING, OTHER, LEGACY_<category>; NULL for custom
  /// types. Never changes.
  code            String?   @unique
  /// Shown as typed; renaming is allowed.
  name            String
  /// lower(trim(name)) with inner spaces collapsed: case-insensitive uniqueness.
  nameKey         String    @unique @map("name_key")
  /// PETROL and OTHER: can't be archived.
  isSystem        Boolean   @default(false) @map("is_system")
  sortOrder       Int       @default(100) @map("sort_order")
  archivedAt      DateTime? @map("archived_at")
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  expenses Expense[]

  @@map("expense_types")
}

// ---------- SETTINGS ----------

// The code holds every key with a typed default (settings registry); a row overrides it.
model AppSetting {
  key             String
  /// "global"; "distributor:<uuid>" later.
  scope           String   @default("global")
  value           Json
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@id([key, scope])
  @@map("app_settings")
}

// ---------- FILES ----------

// Written by FilesService.upload. The bucket is private; reads use signed URLs.
model StoredFile {
  id               String            @id @default(uuid()) @db.Uuid
  /// uploads/yyyy-mm-dd/<uuid>.<ext>
  storageKey       String            @unique @map("storage_key")
  purpose          StoredFilePurpose
  mimeType         String            @map("mime_type")
  sizeBytes        Int               @map("size_bytes")
  sha256           String            @db.Char(64)
  originalName     String?           @map("original_name")
  uploadedByUserId String            @map("uploaded_by_user_id") @db.Uuid
  distributorId    String?           @map("distributor_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at")

  distributor     Distributor? @relation(fields: [distributorId], references: [id])
  payments        Payment[]
  expenses        Expense[]
  dayCloseSheets  DayClose[]   @relation("DayCloseSheet")
  dayCloseUploads DayClose[]   @relation("DayCloseUpload")

  @@index([uploadedByUserId, sha256])
  @@index([distributorId, purpose, createdAt])
  @@map("stored_files")
}

// ---------- DAY-END (Inc 3) ----------

// One business day of one distributor (DATA_MODEL §5.3). Send-back and reopen return a day to OPEN.
enum DayCloseStatus {
  OPEN
  SUBMITTED
  APPROVED // locked: its lines and summary are frozen (scans carry on)
}

// Where a cylinder is, as the sheet and the comparison say it.
enum DayClosePlace {
  STORE
  VAN
  CUSTOMER
  NOT_FOUND // the sheet's "Missing", and the app's place for a LOST cylinder
}

// How a sheet row compares with the app. Each differing line's fix (MOVE_TO_STORE, SET_STATE, MARK_LOST,
// REGISTER or NOTE_ONLY, settled point G09-03) follows from its stored values (API_CONTRACT §10.2).
enum DayCloseDiff {
  MATCH
  PLACE_DIFFERS
  STATE_DIFFERS
  PLACE_AND_STATE_DIFFER
  UNKNOWN_CYLINDER // a number on the "Extra cylinders" sheet the app doesn't know: registered on approval
}

// Created OPEN by the first sheet download for that date (two at once still make one row:
// day_closes_distributor_id_business_date_key). No job creates rows, and a read never does.
model DayClose {
  id               String         @id @default(uuid()) @db.Uuid
  distributorId    String         @map("distributor_id") @db.Uuid
  /// The business date (Asia/Karachi with the 03:00 cut-off: day.timezone, day.cutoffLocalTime).
  businessDate     DateTime       @map("business_date") @db.Date
  status           DayCloseStatus @default(OPEN)
  /// When the newest sheet was made (the sheet time); only that sheet can be uploaded.
  sheetSnapshotAt  DateTime?      @map("sheet_snapshot_at")
  sheetFileId      String?        @map("sheet_file_id") @db.Uuid
  uploadFileId     String?        @map("upload_file_id") @db.Uuid
  uploadVersion    Int            @default(0) @map("upload_version")
  uploadedAt       DateTime?      @map("uploaded_at")
  uploadedByUserId String?        @map("uploaded_by_user_id") @db.Uuid
  submittedAt      DateTime?      @map("submitted_at")
  approvedAt       DateTime?      @map("approved_at")
  approvedByUserId String?        @map("approved_by_user_id") @db.Uuid
  sentBackReason   String?        @map("sent_back_reason")
  sentBackAt       DateTime?      @map("sent_back_at")
  reopenReason     String?        @map("reopen_reason")
  reopenedAt       DateTime?      @map("reopened_at")
  /// Set exactly while APPROVED (day_closes_locked_chk).
  lockedAt         DateTime?      @map("locked_at")
  /// Counts by place, state and size; frozen at approval: an APPROVED day's summary is read from it.
  totals           Json?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  distributor Distributor    @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  sheetFile   StoredFile?    @relation("DayCloseSheet", fields: [sheetFileId], references: [id], onDelete: Restrict)
  uploadFile  StoredFile?    @relation("DayCloseUpload", fields: [uploadFileId], references: [id], onDelete: Restrict)
  lines       DayCloseLine[]

  @@unique([distributorId, businessDate])
  @@index([status, businessDate])
  @@map("day_closes")
}

// One row per cylinder on the uploaded sheet, plus one per extra number. An upload replaces them all.
model DayCloseLine {
  id                String         @id @default(uuid()) @db.Uuid
  dayCloseId        String         @map("day_close_id") @db.Uuid
  /// NULL = a number the app doesn't know (dcl_unknown_chk: exactly the UNKNOWN_CYLINDER lines).
  cylinderId        String?        @map("cylinder_id") @db.Uuid
  /// The number in its normal form (AG-C0042, read by parseCylinderNo). A registered extra cylinder gets
  /// the next short_no instead.
  sheetKey          String         @map("sheet_key")
  cylinderTypeId    String?        @map("cylinder_type_id") @db.Uuid
  systemPlace       DayClosePlace? @map("system_place")
  systemHolderId    String?        @map("system_holder_id") @db.Uuid
  systemState       CylinderState? @map("system_state")
  /// The cylinder's last event at upload (the review's Last scan). A fix is skipped when the cylinder's
  /// last event is newer than the day's sheet_snapshot_at.
  systemLastEventId String?        @map("system_last_event_id") @db.Uuid
  reportedPlace     DayClosePlace? @map("reported_place")
  reportedState     CylinderState? @map("reported_state")
  /// Reserved: NULL in the pilot (there is no reason list).
  reasonCode        String?        @map("reason_code")
  /// "Why different": 3–200 characters on a differing row; the fix's reason.
  note              String?
  diff              DayCloseDiff   @default(MATCH)
  /// The ADJUSTED or REGISTERED event an approved fix wrote.
  appliedEventId    String?        @unique @map("applied_event_id") @db.Uuid
  /// Approval skipped this line's fix: the cylinder moved after the sheet was made.
  skippedMovedAt    DateTime?      @map("skipped_moved_at")

  dayClose     DayClose       @relation(fields: [dayCloseId], references: [id], onDelete: Restrict)
  cylinder     Cylinder?      @relation(fields: [cylinderId], references: [id], onDelete: Restrict)
  cylinderType CylinderType?  @relation(fields: [cylinderTypeId], references: [id], onDelete: Restrict)
  appliedEvent CylinderEvent? @relation("DayCloseLineAppliedEvent", fields: [appliedEventId], references: [id], onDelete: Restrict)

  @@unique([dayCloseId, sheetKey])
  @@index([dayCloseId, diff])
  @@index([cylinderId])
  @@map("day_close_lines")
}

model FuelRefill {
  id          String   @id @default(uuid()) @db.Uuid
  vehicleId   String   @map("vehicle_id") @db.Uuid
  driverId    String   @map("driver_id") @db.Uuid
  litres      Decimal  @db.Decimal(8, 2)
  costPaisa   BigInt   @map("cost_paisa")
  odometerKm  Int      @map("odometer_km")
  fuelStation String?  @map("fuel_station")
  receiptUrl  String?  @map("receipt_url")
  notes       String?
  refillAt    DateTime @default(now()) @map("refill_at")
  createdAt   DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  driver  Driver  @relation(fields: [driverId], references: [id])

  @@index([vehicleId, refillAt])
  @@index([driverId, refillAt])
  @@map("fuel_refills")
}

  actorKind     AuditActorKind @default(USER) @map("actor_kind")
  /// Set exactly when actorKind is USER (CHECK audit_logs_actor_chk).
  actorUserId   String?        @map("actor_user_id") @db.Uuid
  /// For SYSTEM and CUSTOMER actors: job:wallet-check, migration:inc1a, cli:settings, link:AG-0142.
  actorLabel    String?        @map("actor_label")
  /// Stable action code (API_CONTRACT Appendix B), e.g. topup.approve, wallet.correction.
  action        String
  resourceType  String         @map("resource_type")

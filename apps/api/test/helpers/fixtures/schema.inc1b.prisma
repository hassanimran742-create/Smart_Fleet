// ---------- PAYMENTS / LEDGER ----------

// A top-up request. Manual bank top-ups are approved once, against the company bank app.
model Payment {
  id               String              @id @default(uuid()) @db.Uuid
  distributorId    String              @map("distributor_id") @db.Uuid
  /// Human number per distributor, shown as AG-T031 (from Distributor.nextTopupNo).
  requestNo        Int                 @map("request_no")
  /// The Idempotency-Key of the request: a retry returns the first payment.
  clientRequestId  String?             @map("client_request_id") @db.Uuid
  amountPaisa      BigInt              @map("amount_paisa")
  provider         PaymentProviderName
  /// The gateway's transaction id (Easypaisa later). NULL for BANK_MANUAL: no '' placeholders.
  providerTxnId    String?             @map("provider_txn_id")
  status           PaymentStatus       @default(PENDING)
  payerName        String?             @map("payer_name")
  payerChannel     PayerChannel?       @map("payer_channel")
  /// As the distributor typed it; informational, not unique.
  transactionId    String?             @map("transaction_id")
  /// Legacy slip URL of old rows; new screenshots use proofFileId.
  proofUrl         String?             @map("proof_url")
  proofFileId      String?             @map("proof_file_id") @db.Uuid
  /// As the super admin typed it from the company bank app.
  bankReference    String?             @map("bank_reference")
  /// Upper-case A-Z0-9 only, set on approval. Unique: one bank payment approves one top-up, ever.
  bankReferenceKey String?             @unique @map("bank_reference_key")
  /// The amount credited.
  bankAmountPaisa  BigInt?             @map("bank_amount_paisa")
  bankReceivedAt   DateTime?           @map("bank_received_at")
  rejectReasonCode String?             @map("reject_reason_code") // TopupRejectReason
  rejectNote       String?             @map("reject_note")
  /// Who reviewed the request (approve or reject); completedAt is when.
  verifiedByUserId String?             @map("verified_by_user_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at")
  completedAt      DateTime?           @map("completed_at")

  distributor   Distributor   @relation(fields: [distributorId], references: [id])
  proofFile     StoredFile?   @relation(fields: [proofFileId], references: [id], onDelete: Restrict)
  ledgerEntries LedgerEntry[]

  @@unique([provider, providerTxnId])
  @@unique([distributorId, requestNo])
  @@unique([distributorId, clientRequestId])
  @@index([distributorId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

// Append-only. The sum of a distributor's rows equals Distributor.advanceBalancePaisa.
model LedgerEntry {
  id                String          @id @default(uuid()) @db.Uuid
  distributorId     String          @map("distributor_id") @db.Uuid
  entryType         LedgerEntryType @map("entry_type")
  /// Signed: + money in, - money out.
  amountPaisa       BigInt          @map("amount_paisa")
  /// The balance after this row.
  balanceAfterPaisa BigInt          @map("balance_after_paisa")
  /// Exactly-once key: topup:<paymentId>, order:<id>:debit, order:<id>:reversal, adjust:<Idempotency-Key>,
  /// opening:<distributorId>, legacy:<id>.
  idempotencyKey    String          @unique @map("idempotency_key")
  paymentId         String?         @map("payment_id") @db.Uuid
  orderId           String?         @map("order_id") @db.Uuid
  /// Links old refill debits (legacy ADJUSTMENT rows).
  fillingOrderId    String?         @map("filling_order_id") @db.Uuid
  /// CorrectionReason for ADJUSTMENT rows (OPENING_BALANCE for opening entries).
  reasonCode        String?         @map("reason_code")
  note              String?
  /// NULL = a system job.
  createdByUserId   String?         @map("created_by_user_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at")

  distributor  Distributor   @relation(fields: [distributorId], references: [id])
  payment      Payment?      @relation(fields: [paymentId], references: [id])
  order        Order?        @relation(fields: [orderId], references: [id])
  fillingOrder FillingOrder? @relation(fields: [fillingOrderId], references: [id], onDelete: Restrict)

  @@index([distributorId, createdAt])
  @@index([orderId])
  @@index([fillingOrderId])
  @@map("ledger_entries")
}


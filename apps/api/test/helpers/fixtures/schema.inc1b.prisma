  @@index([distributorId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------- ALERTS ----------

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum AlertType {
  DISPATCH_NO_CANDIDATE
  LOW_STOCK
  ORDER_STUCK_PENDING
  DRIVER_OFFLINE_WHILE_ON_TRIP
  PAYMENT_FAILED
  RECONCILIATION_MISMATCH
  CYLINDER_LOST
  DISTRIBUTOR_BALANCE_LOW
  DISTRIBUTOR_CREDIT_OVER
  STORE_STOCK_LOW
  SPECIAL_CLIENT
  OTHER
  WALLET_CHECK_MISMATCH // nightly check: ledger sum <> balance, or balance < 0
}

// User-defined alert rules. Evaluated lazily when the admin opens the
// alerts page (no separate worker needed for the v1 set). `threshold`
// is interpreted per `ruleKind`:
//   DISTRIBUTOR_BALANCE_LOW  → paisa (raise when advance balance falls below)
//   DISTRIBUTOR_CREDIT_OVER  → paisa (raise when negative balance exceeds)
//   STORE_STOCK_LOW          → cylinder count (raise when full count below)
//   SPECIAL_CLIENT           → unused; resourceId points at the Client.
enum AlertRuleKind {
  DISTRIBUTOR_BALANCE_LOW
  DISTRIBUTOR_CREDIT_OVER
  STORE_STOCK_LOW
  SPECIAL_CLIENT
}

model AlertRule {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  ruleKind      AlertRuleKind @map("rule_kind")
  threshold     BigInt        @default(0)
  resourceId    String?       @map("resource_id") @db.Uuid
  cylinderTypeId String?      @map("cylinder_type_id") @db.Uuid
  severity      AlertSeverity @default(WARNING)
  isActive      Boolean       @default(true) @map("is_active")
  notes         String?
  createdBy     String        @map("created_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  lastTriggeredAt DateTime?   @map("last_triggered_at")

  @@index([isActive, ruleKind])
  @@map("alert_rules")
}

model Alert {
  id           String        @id @default(uuid()) @db.Uuid
  alertType    AlertType     @map("alert_type")
  severity     AlertSeverity @default(WARNING)
  status       AlertStatus   @default(OPEN)
  title        String
  body         String
  resourceType String?       @map("resource_type")
  resourceId   String?       @map("resource_id") @db.Uuid
  context      Json?
  acknowledgedAt DateTime?   @map("acknowledged_at")
  resolvedAt   DateTime?     @map("resolved_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([status, severity, createdAt])
  @@map("alerts")
}


// ---------- FUEL REFILLS ----------

// ---------- EXPENSES (super-admin only) ----------

// Legacy fixed categories; old rows were mapped to expense types (archived LEGACY_* types for
// categories with no seeded type). Dropped after the pilot.
enum ExpenseCategory {
  FOOD
  UTILITIES
  LABOUR
  FUEL
  MAINTENANCE
  RENT
  OFFICE
  TRAVEL
  EQUIPMENT
  OTHER
}

// Expenses never touch wallets or the ledger. Removing one is a logged void, never a hard delete.
model Expense {
  id               String           @id @default(uuid()) @db.Uuid
  /// Legacy; read typeId. Dropped after the pilot.
  category         ExpenseCategory?
  typeId           String           @map("type_id") @db.Uuid
  /// The expense's note (UI label "Note").
  description      String
  amountPaisa      BigInt           @map("amount_paisa")
  expenseDate      DateTime         @map("expense_date") @db.Date
  vehicleId        String?          @map("vehicle_id") @db.Uuid
  driverId         String?          @map("driver_id") @db.Uuid
  receiptFileId    String?          @map("receipt_file_id") @db.Uuid
  /// The Idempotency-Key of the create.
  clientRequestId  String?          @unique @map("client_request_id") @db.Uuid
  /// Legacy: kept, never written (receipts are receiptFileId).
  receiptUrl       String?          @map("receipt_url")
  recordedByUserId String           @map("recorded_by_user_id") @db.Uuid
  /// Legacy: kept, never written.
  vendor           String?
  /// Legacy: kept, never written (the note is description).
  notes            String?
  voidedAt         DateTime?        @map("voided_at")
  voidedByUserId   String?          @map("voided_by_user_id") @db.Uuid
  voidReason       String?          @map("void_reason")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  type        ExpenseType  @relation(fields: [typeId], references: [id], onDelete: Restrict)
  vehicle     Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver      Driver?      @relation(fields: [driverId], references: [id], onDelete: Restrict)
  receiptFile StoredFile?  @relation(fields: [receiptFileId], references: [id], onDelete: Restrict)

  @@index([expenseDate])
  @@index([category, expenseDate])
  @@index([typeId, expenseDate])
  @@index([vehicleId, expenseDate])
  @@index([driverId, expenseDate])
  @@map("expenses")
}

// Managed by the super admin: add, rename, archive. Seeded types have a stable code.
model ExpenseType {
  id              String    @id @default(uuid()) @db.Uuid
  /// PETROL, MAINTENANCE, REPAIRS, TYRES, TOLL_PARKING, OTHER, LEGACY_<category>; NULL for custom
  /// types. Never changes.
  code            String?   @unique
  /// Shown as typed; renaming is allowed.
  name            String
  /// lower(trim(name)) with inner spaces collapsed: case-insensitive uniqueness.
  nameKey         String    @unique @map("name_key")
  /// PETROL and OTHER: can't be archived.
  isSystem        Boolean   @default(false) @map("is_system")
  sortOrder       Int       @default(100) @map("sort_order")
  archivedAt      DateTime? @map("archived_at")
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  expenses Expense[]

  @@map("expense_types")
}

// ---------- SETTINGS ----------

// The code holds every key with a typed default (settings registry); a row overrides it.
model AppSetting {
  key             String
  /// "global"; "distributor:<uuid>" later.
  scope           String   @default("global")
  value           Json
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@id([key, scope])
  @@map("app_settings")
}

// ---------- FILES ----------

// Written by FilesService.upload. The bucket is private; reads use signed URLs.
model StoredFile {
  id               String            @id @default(uuid()) @db.Uuid
  /// uploads/yyyy-mm-dd/<uuid>.<ext>
  storageKey       String            @unique @map("storage_key")
  purpose          StoredFilePurpose
  mimeType         String            @map("mime_type")
  sizeBytes        Int               @map("size_bytes")
  sha256           String            @db.Char(64)
  originalName     String?           @map("original_name")
  uploadedByUserId String            @map("uploaded_by_user_id") @db.Uuid
  distributorId    String?           @map("distributor_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at")

  distributor Distributor? @relation(fields: [distributorId], references: [id])
  payments    Payment[]
  expenses    Expense[]

  @@index([uploadedByUserId, sha256])
  @@index([distributorId, purpose, createdAt])
  @@map("stored_files")
}

model FuelRefill {
  id          String   @id @default(uuid()) @db.Uuid
  vehicleId   String   @map("vehicle_id") @db.Uuid
  driverId    String   @map("driver_id") @db.Uuid
  litres      Decimal  @db.Decimal(8, 2)
  costPaisa   BigInt   @map("cost_paisa")
  odometerKm  Int      @map("odometer_km")
  fuelStation String?  @map("fuel_station")
  receiptUrl  String?  @map("receipt_url")
  notes       String?
  refillAt    DateTime @default(now()) @map("refill_at")
  createdAt   DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  driver  Driver  @relation(fields: [driverId], references: [id])

  @@index([vehicleId, refillAt])
  @@index([driverId, refillAt])
  @@map("fuel_refills")
}

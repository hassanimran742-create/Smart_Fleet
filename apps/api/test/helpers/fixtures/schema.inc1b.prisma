// Smart_Fleet Prisma schema
// PostgreSQL 16 + PostGIS 3.4. Spatial columns use Unsupported("geometry(...,4326)").
// Spatial queries go through PrismaService.$queryRaw.
//
// Changes ship only as migrations made with `npm run db:new-migration -- <name>`
// (docs/pilot/DATA_MODEL.md §2). Never `prisma db push` or `prisma db pull`.
// New columns stay nullable or defaulted (expand, then contract one release later),
// so the raw INSERTs on geometry tables keep working (DATA_MODEL §6).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, uuidOssp(map: "uuid-ossp"), pgcrypto]
}

// ---------- ENUMS ----------

enum UserRole {
  SUPER_ADMIN
  ADMIN
  DISPATCHER
  STORE_KEEPER
  DISTRIBUTOR
  DRIVER
  CLIENT
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum OtpPurpose {
  LOGIN
  RESET
}

enum CylinderState {
  FULL
  EMPTY
  FAULTY
  LOST
}

enum CustodyType {
  DISTRIBUTOR
  STORE
  VEHICLE
  CLIENT
}

enum CylinderEventType {
  SCAN_IN
  SCAN_OUT
  DELIVERED
  PICKED_UP_EMPTY
  RETURNED_TO_DISTRIBUTOR
  TRANSFER
  MARK_FAULTY
  MARK_LOST
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

enum DriverAvailability {
  AVAILABLE
  ON_LEAVE
  OFF_DUTY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  FAILED
}

// Legacy mirror for old app builds: PAID_VIA_LEDGER while Order.feeStatus is DEDUCTED, UNPAID otherwise.
enum OrderPaymentStatus {
  UNPAID
  PAID_VIA_LEDGER
  PAID_DIRECT
}

// The money state of an order. The cost is deducted when the order is placed and
// returned once, only on a cancel before delivery has started.
enum OrderFeeStatus {
  NONE // no cost taken: legacy order, or a cost of 0
  DEDUCTED
  REVERSED
}

enum FeeStrategy {
  DISTRIBUTOR_ZONE // pilot: the distributor's price for the customer's zone
  LEGACY_ZONE_PAIR // old orders priced by PricingRule
}

enum DeliveryMethod {
  DRIVER_TAP // Inc 1: the driver taps Delivered
  SCANNED // Inc 2: the hand-over scans
  MANUAL // the office, with a reason
}

enum TripStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  ABORTED
}

enum TripStopType {
  STORE_PICKUP
  DELIVERY
  RETURN_DROPOFF
}

enum TripStopStatus {
  PENDING
  ARRIVED
  DONE
  FAILED
  CANCELLED
}

enum TransferStatus {
  REQUESTED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum PaymentProviderName {
  JAZZCASH
  EASYPAISA
  BANK_MANUAL
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  REJECTED // the super admin said no (legacy BANK_MANUAL FAILED rows are relabelled in inc1b)
}

enum PayerChannel {
  EASYPAISA_APP
  BANK_APP
  OTHER
}

// Signed ledger rows. Opening balances and corrections are ADJUSTMENT with a reason_code.
enum LedgerEntryType {
  CREDIT_TOPUP
  DEBIT_ORDER
  ADJUSTMENT
  CREDIT_ORDER_REVERSAL // the delivery cost returned on a cancel before delivery started
  DEBIT_REFILL // reserved for refill.deliveryCost; never written while it is off
}

enum DistributorStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ReconciliationStatus {
  PENDING
  VERIFIED
  FLAGGED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AuditActorKind {
  USER
  SYSTEM // jobs, CLIs and migrations; actor_label says which
  CUSTOMER // the confirmation link (Inc 2)
}

enum StoredFilePurpose {
  TOPUP_PROOF
  EXPENSE_RECEIPT
  DAY_END_SHEET
  DAY_END_UPLOAD
  OTHER
}

// ---------- USERS / AUTH ----------

model User {
  id           String     @id @default(uuid()) @db.Uuid
  phone        String     @unique
  email        String?    @unique
  name         String
  role         UserRole
  status       UserStatus @default(PENDING)
  cnic         String?
  profilePictureUrl String? @map("profile_picture_url")
  cnicEncrypted Bytes?    @map("cnic_encrypted")
  cnicIndex    String?    @map("cnic_index") @db.Char(64)
  passwordHash String?    @map("password_hash")
  /// Sent as the `tv` token claim; bumped on suspend, archive, role change and password reset.
  tokenVersion Int        @default(0) @map("token_version")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  distributorProfile Distributor?
  driverProfile      Driver?
  clientProfile      Client?
  refreshTokens      RefreshToken[]
  cylinderEvents     CylinderEvent[]  @relation("ActorEvents")
  auditLogs          AuditLog[]
  reconciliations    Reconciliation[]

  @@map("users")
}

model OtpCode {
  id         String     @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String     @map("code_hash")
  purpose    OtpPurpose
  expiresAt  DateTime   @map("expires_at")
  consumedAt DateTime?  @map("consumed_at")
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@map("otp_codes")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  parentId  String?   @map("parent_id") @db.Uuid
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------- ROLE PROFILES ----------

model Distributor {
  id                  String            @id @default(uuid()) @db.Uuid
  userId              String            @unique @map("user_id") @db.Uuid
  businessName        String            @map("business_name")
  /// Short code for human numbers (order AG-0142, top-up AG-T031): ^[A-Z][A-Z0-9]{1,5}$, set by the
  /// super admin, locked after the first order. Old rows were backfilled D01, D02... (inc1a).
  code                String            @unique
  /// The distributor's one store; every trip and refill starts there.
  homeStoreId         String            @unique @map("home_store_id") @db.Uuid
  /// THE wallet balance (no holds, no split). The ledger sum always equals it.
  advanceBalancePaisa BigInt            @default(0) @map("advance_balance_paisa")
  status              DistributorStatus @default(PENDING)
  /// Human-number counters, allocated inside the creating transaction (UPDATE ... RETURNING).
  nextOrderNo         Int               @default(1) @map("next_order_no")
  nextTopupNo         Int               @default(1) @map("next_topup_no")
  nextRefillNo        Int               @default(1) @map("next_refill_no") // Inc 3
  nextCylinderNo      Int               @default(1) @map("next_cylinder_no") // Inc 2
  /// The Idempotency-Key of POST /distributors: a retry returns this distributor (API_CONTRACT §4.2).
  clientRequestId     String?           @unique @map("client_request_id") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  user          User                   @relation(fields: [userId], references: [id])
  homeStore     Store                  @relation(fields: [homeStoreId], references: [id], onDelete: Restrict)
  clients       Client[]
  cylinders     Cylinder[]
  orders        Order[]
  ledgerEntries LedgerEntry[]
  payments      Payment[]
  fillingOrders FillingOrder[]
  zonePrices    DistributorZonePrice[]
  files         StoredFile[]

  @@map("distributors")
}

model Driver {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @unique @map("user_id") @db.Uuid
  licenceNo                String    @unique @map("licence_no")
  currentVehicleId         String?   @unique @map("current_vehicle_id") @db.Uuid
  currentZoneId            String?   @map("current_zone_id") @db.Uuid
  currentLocation          Unsupported("geometry(Point,4326)")? @map("current_location")
  currentLocationUpdatedAt DateTime? @map("current_location_updated_at")
  isOnline                 Boolean   @default(false) @map("is_online")
  availability             DriverAvailability @default(AVAILABLE)
  leaveStart               DateTime? @map("leave_start")
  leaveEnd                 DateTime? @map("leave_end")
  leaveReason              String?   @map("leave_reason")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  user           User    @relation(fields: [userId], references: [id])
  currentVehicle Vehicle? @relation("DriverCurrentVehicle", fields: [currentVehicleId], references: [id])
  currentZone    Zone?    @relation(fields: [currentZoneId], references: [id])
  trips          Trip[]
  reconciliations Reconciliation[]
  shifts         DriverShift[]
  fuelRefills    FuelRefill[]
  fillingOrders  FillingOrder[]
  transfers      Transfer[]     @relation("TransferDriver")
  expenses       Expense[]

  @@index([isOnline])
  @@index([availability])
  @@map("drivers")
}

model DriverShift {
  id        String    @id @default(uuid()) @db.Uuid
  driverId  String    @map("driver_id") @db.Uuid
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  driver Driver @relation(fields: [driverId], references: [id])

  @@index([driverId, startedAt])
  @@map("driver_shifts")
}

// ---------- GEOGRAPHY ----------

model City {
  id          String @id @default(uuid()) @db.Uuid
  name        String
  countryCode String @default("PK") @map("country_code")

  zones        Zone[]
  pricingRules PricingRule[]

  @@map("cities")
}

model Zone {
  id        String @id @default(uuid()) @db.Uuid
  cityId    String @map("city_id") @db.Uuid
  name      String
  polygon   Unsupported("geometry(MultiPolygon,4326)")
  centroid  Unsupported("geometry(Point,4326)")?
  isActive  Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  city     City      @relation(fields: [cityId], references: [id])
  stores   Store[]
  vehicles Vehicle[]
  drivers  Driver[]
  ordersAsDest      Order[]       @relation("OrderDestZone")
  pricingAsOrigin   PricingRule[] @relation("PricingOrigin")
  pricingAsDest     PricingRule[] @relation("PricingDest")
  zonePrices        DistributorZonePrice[]
  clientAddresses   ClientAddress[]

  @@index([polygon], type: Gist)
  @@index([cityId, isActive])
  @@map("zones")
}

model Store {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  zoneId    String  @map("zone_id") @db.Uuid
  address   String
  location  Unsupported("geometry(Point,4326)")
  isActive  Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  zone           Zone           @relation(fields: [zoneId], references: [id])
  /// The one distributor whose store this is (Distributor.homeStoreId is unique).
  distributor    Distributor?
  ordersAsOrigin Order[]        @relation("OrderOriginStore")
  trips          Trip[]
  tripStops      TripStop[]
  transfersFrom  Transfer[]     @relation("TransferFromStore")
  transfersTo    Transfer[]     @relation("TransferToStore")
  fillingPickups FillingOrder[]

  @@index([location], type: Gist)
  @@map("stores")
}

// ---------- VEHICLES ----------

model Vehicle {
  id                String        @id @default(uuid()) @db.Uuid
  plateNo           String        @unique @map("plate_no")
  capacityUnits     Int           @map("capacity_units")
  homeZoneId        String        @map("home_zone_id") @db.Uuid
  status            VehicleStatus @default(ACTIVE)
  currentOdometerKm Int           @default(0) @map("current_odometer_km")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  homeZone        Zone           @relation(fields: [homeZoneId], references: [id])
  currentDriver   Driver?        @relation("DriverCurrentVehicle")
  trips           Trip[]
  transfers       Transfer[]
  fuelRefills     FuelRefill[]
  fillingOrders   FillingOrder[]
  expenses        Expense[]

  @@map("vehicles")
}

// ---------- CLIENTS ----------

model Client {
  id               String   @id @default(uuid()) @db.Uuid
  distributorId    String   @map("distributor_id") @db.Uuid
  userId           String?  @unique @map("user_id") @db.Uuid
  name             String
  phone            String
  address          String?
  area             String?
  city             String?
  creditLimitPaisa BigInt   @default(0) @map("credit_limit_paisa")
  priority         Int      @default(3)
  notes            String?
  /// The Idempotency-Key of POST /clients: a retry returns this customer (API_CONTRACT §4.2).
  clientRequestId  String?  @map("client_request_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  distributor Distributor      @relation(fields: [distributorId], references: [id])
  user        User?            @relation(fields: [userId], references: [id])
  addresses   ClientAddress[]
  orders      Order[]

  @@unique([distributorId, clientRequestId])
  /// One customer per phone number within a distributor (inc1b; POST /clients checks it first).
  @@unique([distributorId, phone])
  @@index([distributorId])
  @@map("clients")
}

model ClientAddress {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  label     String
  location  Unsupported("geometry(Point,4326)")
  /// The zone that covered the pin when it was saved (NULL = outside every active zone), kept for the
  /// record; lists, quotes and orders re-check the pin live against the active zones.
  zoneId    String?  @map("zone_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id])
  zone   Zone?  @relation(fields: [zoneId], references: [id])

  @@index([clientId])
  @@map("client_addresses")
}

// ---------- CYLINDERS ----------

model CylinderType {
  id            String @id @default(uuid()) @db.Uuid
  code          String @unique
  name          String
  weightKg      Decimal @map("weight_kg") @db.Decimal(6, 2)
  capacityUnits Int     @map("capacity_units")

  cylinders  Cylinder[]
  orderLines OrderLine[]
  pricingRules PricingRule[]
  fillingOrders FillingOrder[]
  zonePriceSizes DistributorZonePriceSize[]

  @@map("cylinder_types")
}

model Cylinder {
  id             String        @id @default(uuid()) @db.Uuid
  serial         String        @unique
  qrCode         String        @unique @map("qr_code")
  distributorId  String        @map("distributor_id") @db.Uuid
  cylinderTypeId String        @map("cylinder_type_id") @db.Uuid
  state          CylinderState @default(EMPTY)
  custodyType    CustodyType   @map("custody_type")
  custodyId      String        @map("custody_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  distributor  Distributor     @relation(fields: [distributorId], references: [id])
  cylinderType CylinderType    @relation(fields: [cylinderTypeId], references: [id])
  events       CylinderEvent[]
  transferLines TransferLine[]

  @@index([distributorId, cylinderTypeId, state, custodyType])
  @@map("cylinders")
}

model CylinderEvent {
  id              String              @id @default(uuid()) @db.Uuid
  cylinderId      String              @map("cylinder_id") @db.Uuid
  eventType       CylinderEventType   @map("event_type")
  fromCustodyType CustodyType?        @map("from_custody_type")
  fromCustodyId   String?             @map("from_custody_id") @db.Uuid
  toCustodyType   CustodyType?        @map("to_custody_type")
  toCustodyId     String?             @map("to_custody_id") @db.Uuid
  actorUserId     String              @map("actor_user_id") @db.Uuid
  photoUrl        String?             @map("photo_url")
  location        Unsupported("geometry(Point,4326)")?
  tripId          String?             @map("trip_id") @db.Uuid
  orderId         String?             @map("order_id") @db.Uuid
  transferId      String?             @map("transfer_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at")

  cylinder Cylinder @relation(fields: [cylinderId], references: [id])
  actor    User     @relation("ActorEvents", fields: [actorUserId], references: [id])

  @@index([cylinderId, createdAt])
  @@map("cylinder_events")
}

// ---------- INVENTORY ----------

model InventoryLot {
  id             String        @id @default(uuid()) @db.Uuid
  holderType     CustodyType   @map("holder_type")
  holderId       String        @map("holder_id") @db.Uuid
  distributorId  String        @map("distributor_id") @db.Uuid
  cylinderTypeId String        @map("cylinder_type_id") @db.Uuid
  state          CylinderState
  count          Int           @default(0)
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@unique([holderType, holderId, distributorId, cylinderTypeId, state], name: "inventory_unique")
  @@map("inventory_lots")
}

// ---------- TRANSFERS ----------

model Transfer {
  id            String         @id @default(uuid()) @db.Uuid
  fromStoreId   String         @map("from_store_id") @db.Uuid
  toStoreId     String         @map("to_store_id") @db.Uuid
  vehicleId     String?        @map("vehicle_id") @db.Uuid
  driverId      String?        @map("driver_id") @db.Uuid
  scheduledFor  DateTime?      @map("scheduled_for")
  notes         String?
  status        TransferStatus @default(REQUESTED)
  requestedBy   String         @map("requested_by") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")
  completedAt   DateTime?      @map("completed_at")

  fromStore Store           @relation("TransferFromStore", fields: [fromStoreId], references: [id])
  toStore   Store           @relation("TransferToStore", fields: [toStoreId], references: [id])
  vehicle   Vehicle?        @relation(fields: [vehicleId], references: [id])
  driver    Driver?         @relation("TransferDriver", fields: [driverId], references: [id])
  lines     TransferLine[]

  @@index([driverId, status])
  @@index([scheduledFor])
  @@map("transfers")
}

model TransferLine {
  id         String @id @default(uuid()) @db.Uuid
  transferId String @map("transfer_id") @db.Uuid
  cylinderId String @map("cylinder_id") @db.Uuid

  transfer Transfer @relation(fields: [transferId], references: [id])
  cylinder Cylinder @relation(fields: [cylinderId], references: [id])

  @@unique([transferId, cylinderId])
  @@map("transfer_lines")
}

// ---------- PRICING ----------

// Legacy zone-pair pricing (FeeStrategy.LEGACY_ZONE_PAIR). Frozen: read for old orders only.
model PricingRule {
  id              String   @id @default(uuid()) @db.Uuid
  cityId          String   @map("city_id") @db.Uuid
  originZoneId    String   @map("origin_zone_id") @db.Uuid
  destZoneId      String   @map("dest_zone_id") @db.Uuid
  cylinderTypeId  String   @map("cylinder_type_id") @db.Uuid
  basePaisa       BigInt   @map("base_paisa")
  perUnitPaisa    BigInt   @map("per_unit_paisa")
  effectiveFrom   DateTime @map("effective_from")
  effectiveUntil  DateTime? @map("effective_until")

  city         City         @relation(fields: [cityId], references: [id])
  originZone   Zone         @relation("PricingOrigin", fields: [originZoneId], references: [id])
  destZone     Zone         @relation("PricingDest", fields: [destZoneId], references: [id])
  cylinderType CylinderType @relation(fields: [cylinderTypeId], references: [id])

  @@unique([cityId, originZoneId, destZoneId, cylinderTypeId, effectiveFrom], name: "pricing_unique_active")
  @@map("pricing_rules")
}

// The delivery price: one current row per distributor per zone, edited in place
// (every edit writes a before/after audit row). Cost = base + Σ(per-size amount × full cylinders).
// Orders keep their own copy of the cost, so there is no foreign key from orders to this table.
model DistributorZonePrice {
  id              String   @id @default(uuid()) @db.Uuid
  distributorId   String   @map("distributor_id") @db.Uuid
  zoneId          String   @map("zone_id") @db.Uuid
  /// Charged once per order.
  basePaisa       BigInt   @map("base_paisa")
  note            String?
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  distributor Distributor                @relation(fields: [distributorId], references: [id])
  zone        Zone                       @relation(fields: [zoneId], references: [id])
  sizes       DistributorZonePriceSize[]

  @@unique([distributorId, zoneId])
  @@index([zoneId])
  @@map("distributor_zone_prices")
}

// Optional per-size amounts. A size with no row costs 0 per cylinder.
model DistributorZonePriceSize {
  id               String @id @default(uuid()) @db.Uuid
  priceId          String @map("price_id") @db.Uuid
  cylinderTypeId   String @map("cylinder_type_id") @db.Uuid
  perCylinderPaisa BigInt @map("per_cylinder_paisa")

  price        DistributorZonePrice @relation(fields: [priceId], references: [id], onDelete: Cascade)
  cylinderType CylinderType         @relation(fields: [cylinderTypeId], references: [id])

  @@unique([priceId, cylinderTypeId])
  @@map("distributor_zone_price_sizes")
}

// ---------- ORDERS / TRIPS ----------

model Order {
  id                   String              @id @default(uuid()) @db.Uuid
  distributorId        String              @map("distributor_id") @db.Uuid
  clientId             String              @map("client_id") @db.Uuid
  deliveryAddress      Unsupported("geometry(Point,4326)") @map("delivery_address")
  deliveryAddressLabel String              @map("delivery_address_label")
  destZoneId           String              @map("dest_zone_id") @db.Uuid
  originStoreId        String?             @map("origin_store_id") @db.Uuid
  /// Human number per distributor, shown as AG-0142 (from Distributor.nextOrderNo).
  orderNo              Int                 @map("order_no")
  /// The Idempotency-Key of "Place order": a retry returns the first order.
  clientRequestId      String?             @map("client_request_id") @db.Uuid
  status               OrderStatus         @default(PENDING)
  /// Legacy mirror for old app builds; read feeStatus.
  paymentStatus        OrderPaymentStatus  @default(UNPAID) @map("payment_status")
  /// The cost deducted from the wallet when the order was placed (0 when nothing was taken).
  deliveryFeePaisa     BigInt              @default(0) @map("delivery_fee_paisa")
  feeStatus            OrderFeeStatus      @default(NONE) @map("fee_status")
  feeStrategy          FeeStrategy?        @map("fee_strategy")
  feeBasePaisa         BigInt?             @map("fee_base_paisa")
  feeQuotedAt          DateTime?           @map("fee_quoted_at")
  /// {zoneId, zoneName, priceId, priceUpdatedAt}: display only; the amount columns are authoritative.
  feeDetails           Json?               @map("fee_details")
  scheduledWindowStart DateTime?           @map("scheduled_window_start")
  scheduledWindowEnd   DateTime?           @map("scheduled_window_end")
  tripId               String?             @map("trip_id") @db.Uuid
  assignedAt           DateTime?           @map("assigned_at")
  /// The first load scan on the order's trip: the refund cut-off (orders.deliveryStartedAt).
  loadStartedAt        DateTime?           @map("load_started_at")
  onTheWayAt           DateTime?           @map("on_the_way_at")
  /// Written once.
  deliveredAt          DateTime?           @map("delivered_at")
  deliveredByUserId    String?             @map("delivered_by_user_id") @db.Uuid
  deliveryMethod       DeliveryMethod?     @map("delivery_method")
  manualDeliveryReason String?             @map("manual_delivery_reason")
  /// The free-text cancel note; the stable code is cancelReasonCode.
  cancellationReason    String?             @map("cancellation_reason")
  cancelledAt          DateTime?           @map("cancelled_at")
  cancelledByUserId    String?             @map("cancelled_by_user_id") @db.Uuid
  cancelReasonCode     String?             @map("cancel_reason_code") // OrderCancelReason
  failedAt             DateTime?           @map("failed_at")
  failureReasonCode    String?             @map("failure_reason_code") // DeliveryFailureReason
  failureNote          String?             @map("failure_note")
  clientConfirmedAt     DateTime?           @map("client_confirmed_at")
  emptiesHandedOverAt   DateTime?           @map("empties_handed_over_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  distributor Distributor   @relation(fields: [distributorId], references: [id])
  client      Client        @relation(fields: [clientId], references: [id])
  destZone    Zone          @relation("OrderDestZone", fields: [destZoneId], references: [id])
  originStore Store?        @relation("OrderOriginStore", fields: [originStoreId], references: [id])
  trip        Trip?         @relation(fields: [tripId], references: [id])
  lines       OrderLine[]
  stops       TripStop[]
  ledger      LedgerEntry[]

  @@unique([distributorId, orderNo])
  @@unique([distributorId, clientRequestId])
  @@index([distributorId, status])
  @@index([distributorId, createdAt])
  @@index([status, createdAt])
  @@index([status, deliveredAt])
  @@index([tripId])
  @@map("orders")
}

model OrderLine {

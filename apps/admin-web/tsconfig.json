{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": "./",
    "paths": {
      "@smartfleet/shared-types": ["../../packages/shared-types/src"],
      "@smartfleet/shared-utils": ["../../packages/shared-utils/src"],
      "@smartfleet/shared-validation": ["../../packages/shared-validation/src"]
    }
  },
  "include": ["src"]
}

{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://10.0.2.2:3000/api/v1",
        "EXPO_PUBLIC_ENV": "development"
      },
      "android": { "buildType": "apk" }
    },

    "distributor-staging": {
      "distribution": "internal",
      "channel": "distributor-staging",
      "env": {
        "APP_VARIANT": "distributor",
        "EXPO_PUBLIC_API_BASE_URL": "https://staging.smartfleetpk.com/api/v1",
        "EXPO_PUBLIC_ENV": "staging"
      },
      "android": { "buildType": "apk" }
    },
    "driver-staging": {
      "distribution": "internal",
      "channel": "driver-staging",
      "env": {
        "APP_VARIANT": "driver",
        "EXPO_PUBLIC_API_BASE_URL": "https://staging.smartfleetpk.com/api/v1",
        "EXPO_PUBLIC_ENV": "staging"
      },
      "android": { "buildType": "apk" }
    },

    "distributor-production": {
      "distribution": "internal",
      "channel": "distributor-production",
      "env": {
        "APP_VARIANT": "distributor",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.smartfleetpk.com/api/v1",
        "EXPO_PUBLIC_ENV": "production"
      },
      "android": { "buildType": "apk" },
      "autoIncrement": true
    },
    "driver-production": {
      "distribution": "internal",
      "channel": "driver-production",
      "env": {
        "APP_VARIANT": "driver",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.smartfleetpk.com/api/v1",
        "EXPO_PUBLIC_ENV": "production"
      },
      "android": { "buildType": "apk" },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}

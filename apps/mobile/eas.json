{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://10.0.2.2:3000/api/v1",
        "EXPO_PUBLIC_ENV": "development"
      },
      "android": { "buildType": "apk" }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://smart-fleet-staging.up.railway.app/api/v1",
        "EXPO_PUBLIC_ENV": "staging",
        "EXPO_PUBLIC_SENTRY_DSN": "REPLACE_WITH_MOBILE_SENTRY_DSN"
      },
      "android": { "buildType": "apk" }
    },
    "production": {
      "distribution": "internal",
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://smart-fleet-production.up.railway.app/api/v1",
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_SENTRY_DSN": "REPLACE_WITH_MOBILE_SENTRY_DSN"
      },
      "android": { "buildType": "apk" },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}

}

# The hosts the apps call: eas.json and the website build use https://api.smartfleetpk.com (prod)
# and https://staging.smartfleetpk.com (staging). From Inc 2 the same hosts serve the customer's
# delivery link page at /c/<token> (CUSTOMER_PAGE §4-§5; PUBLIC_LINK_BASE_URL is the API host until a
# short link domain is chosen).
#
# The link page sends its own security headers (Referrer-Policy no-referrer, X-Content-Type-Options,
# X-Robots-Tag and a CSP with frame-ancestors 'none'), so the site-wide headers below skip /c/* rather
# than override or duplicate them; HSTS applies everywhere. The access log replaces a link's token with
# [token] and drops the Referer header, so tokens never reach the logs (CUSTOMER_PAGE §5, §12).
api.smartfleetpk.com {
	reverse_proxy api-prod:3001 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	encode zstd gzip

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "^/c/[0-9a-z]+" "/c/[token]"
				request>headers>Referer delete
			}
		}
	}

	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	@notLinkPage not path /c /c/*
	header @notLinkPage {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

staging.smartfleetpk.com {
	reverse_proxy api-staging:3002 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	encode zstd gzip

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp "^/c/[0-9a-z]+" "/c/[token]"
				request>headers>Referer delete
			}
		}
	}

	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	@notLinkPage not path /c /c/*
	header @notLinkPage {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}


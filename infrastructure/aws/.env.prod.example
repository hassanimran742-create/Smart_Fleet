# Smart_Fleet — PRODUCTION environment
# Placed on EC2 at /srv/smartfleet/.env.prod (mode 0600, owned by root)
# Never commit the real file to git. This is a template only.

NODE_ENV=production
# Deployment name (development | test | staging | training | production), reported by GET /app/config.
APP_ENV=production
API_PORT=3001
LOG_LEVEL=info

# --- Database (RDS Postgres, private subnet, TLS required) ---
# Format: postgresql://USER:PASSWORD@RDS_HOST:5432/smartfleet_prod?schema=public&sslmode=require
DATABASE_URL=postgresql://smartfleet_admin:REPLACE_DB_PASSWORD@REPLACE_RDS_HOST:5432/smartfleet_prod?schema=public&sslmode=require

# --- Redis (ElastiCache, TLS) ---
# Format: rediss://REDIS_HOST:6379/0  (prod uses DB 0)
REDIS_URL=rediss://REPLACE_REDIS_HOST:6379/0
# Namespaces queue and rate-limit keys. The API refuses to boot unless it names the environment.
BULLMQ_PREFIX=sf-prod

# --- Object storage (S3) ---
S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=REPLACE_AWS_ACCESS_KEY
S3_SECRET_KEY=REPLACE_AWS_SECRET_KEY
S3_BUCKET=smartfleet-files-prod
S3_FORCE_PATH_STYLE=false

# --- Auth secrets (32-byte hex, openssl rand -hex 32 or PowerShell New-Secret) ---
JWT_ACCESS_SECRET=REPLACE_JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_JWT_REFRESH_SECRET
JWT_ACCESS_TTL=43200
JWT_REFRESH_TTL=2592000

# --- Application-layer PII encryption (32-byte hex) ---
# Both REQUIRED: 64 hex characters each (openssl rand -hex 32), or the API refuses to boot.
ENCRYPTION_KEY=REPLACE_ENCRYPTION_KEY
BLIND_INDEX_KEY=REPLACE_BLIND_INDEX_KEY

# --- SMS (mock for pilot — real provider deferred) ---
SMS_PROVIDER=mock
SMS_FROM=SmartFleet

# --- Observability ---
SENTRY_DSN=REPLACE_SENTRY_DSN_API_PROD
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production

POSTHOG_API_KEY=REPLACE_POSTHOG_API_KEY
POSTHOG_HOST=https://us.posthog.com

# --- CORS: the office website's origin(s), comma-separated: scheme and host only, no path. ---
# The browser blocks every website call (sign-in included) from an origin not listed here, so
# copy it from the address bar (the live office website is https://admin.smartfleetpk.com).
# The API refuses to boot while it is empty, '*', not an origin or still REPLACE_, and it logs
# the list it uses at boot ("CORS origins: ...").
CORS_ORIGINS=REPLACE_WEBSITE_ORIGIN
# Optional: where an out-of-date phone gets the new app (GET /app/config links.updateUrl).
# APP_UPDATE_URL=

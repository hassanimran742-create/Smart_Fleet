# Smart_Fleet — STAGING environment
# Placed on EC2 at /srv/smartfleet/.env.staging (mode 0600, owned by root)
# Never commit the real file to git. This is a template only.

NODE_ENV=staging
# Deployment name (development | test | staging | training | production), reported by GET /app/config.
APP_ENV=staging
API_PORT=3002
LOG_LEVEL=debug

# --- Database (same RDS instance, separate database name) ---
DATABASE_URL=postgresql://smartfleet_admin:REPLACE_DB_PASSWORD@REPLACE_RDS_HOST:5432/smartfleet_staging?schema=public&sslmode=require

# --- Redis (same ElastiCache node, separate logical DB = 1) ---
REDIS_URL=rediss://REPLACE_REDIS_HOST:6379/1
# Namespaces queue and rate-limit keys. The API refuses to boot unless it names the environment.
BULLMQ_PREFIX=sf-staging

# --- Object storage ---
S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=REPLACE_AWS_ACCESS_KEY
S3_SECRET_KEY=REPLACE_AWS_SECRET_KEY
S3_BUCKET=smartfleet-files-staging
S3_FORCE_PATH_STYLE=false

# --- Auth secrets (DIFFERENT from prod) ---
JWT_ACCESS_SECRET=REPLACE_JWT_ACCESS_SECRET_STAGING
JWT_REFRESH_SECRET=REPLACE_JWT_REFRESH_SECRET_STAGING
JWT_ACCESS_TTL=43200
JWT_REFRESH_TTL=2592000

# --- PII encryption (DIFFERENT from prod) ---
# Both REQUIRED: 64 hex characters each (openssl rand -hex 32), or the API refuses to boot.
ENCRYPTION_KEY=REPLACE_ENCRYPTION_KEY_STAGING
BLIND_INDEX_KEY=REPLACE_BLIND_INDEX_KEY_STAGING

# --- SMS (mock with visible OTP in dev response for staging testing) ---
SMS_PROVIDER=mock
SMS_FROM=SmartFleet-staging

# --- Customer delivery confirmation (from Inc 2; CUSTOMER_PAGE §2, §5, §8) ---
# REQUIRED from Inc 2, or the API refuses to boot (API_CONTRACT §3.7).
# The base of the customer's link, https: the staging API host.
PUBLIC_LINK_BASE_URL=https://staging.smartfleetpk.com
# Signs the customer links: at least 32 characters (openssl rand -hex 32), DIFFERENT from prod.
CONFIRM_LINK_SECRET=REPLACE_CONFIRM_LINK_SECRET_STAGING
# The message provider for the confirmation SMS: mock (sends nothing, logs a masked line).
# An unknown name refuses to boot.
MESSAGING_PROVIDER=mock

# --- Observability ---
SENTRY_DSN=REPLACE_SENTRY_DSN_API_STAGING
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_ENVIRONMENT=staging

POSTHOG_API_KEY=REPLACE_POSTHOG_API_KEY
POSTHOG_HOST=https://us.posthog.com

# --- CORS: the office website's origin(s), comma-separated: scheme and host only, no path. ---
# The browser blocks every website call (sign-in included) from an origin not listed here, so
# copy it from the address bar (the staging website).
# The API refuses to boot while it is empty, '*', not an origin or still REPLACE_, and it logs
# the list it uses at boot ("CORS origins: ...").
CORS_ORIGINS=REPLACE_WEBSITE_ORIGIN
# Optional: where an out-of-date phone gets the new app (GET /app/config links.updateUrl).
# APP_UPDATE_URL=
